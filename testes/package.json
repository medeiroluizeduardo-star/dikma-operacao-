{
  "name": "dikma-testes",
  "private": true,
  "type": "module",
  "description": "Testes automáticos: regras de segurança do Firestore e rotinas do GitHub, no emulador do Firebase",
  "scripts": {
    "test": "node --test --test-concurrency=1 regras.test.mjs rotinas.test.mjs",
    "emulador": "firebase emulators:exec --only firestore,auth --project demo-dikma --config ../firebase.json \"npm test\""
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.0.0"
  }
}
