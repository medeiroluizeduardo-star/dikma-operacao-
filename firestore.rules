rules_version = '2';
// Regras de segurança — Dikma Gestão (Coqueria)
// ACESSO POR MÓDULO (usuarios/{uid}.acesso, a partir da fase 2 da divisão em 5 módulos):
//   acesso  = { operacao, gestao, seguranca, rh: perfil no módulo; administracao: 'admin' | 'modulo' }
//   escopos = parte de ['patio', 'bateria', 'equipamentos']; as Fichas de acompanhamento = 'gestao' em modulos.
//   Cada regra confere o perfil DO MÓDULO certo:
//   - Pátio/Bateria (semanas, aprov, plano, colaboradores, situacao, acoes): ler = Operação ou Gestão + escopo;
//     apontar e lançar a presença = Operação (líder a gestor) na área; aprovar = Operação · Supervisor
//     (o administrador é a reserva); ações das causas = Operação ou Gestão (supervisor para cima) na área.
//   - Plano, rotas, gerador = Administração: administrador, ou 'Dos módulos' com Gestão · Gestor no escopo.
//   - Equipamentos (eq*) = escopo Equipamentos: Operação grava; Gestão lê (e lança a Avaliação mensal).
//   - Fichas (gestao, gcolab, gocorr, gassin) = Gestão com as Fichas.
//   - RH (freqcomp, ferias, adm) = RH: Administrativo grava, Somente leitura lê.
//   - Usuários, config/permissoes = Administração completa (administrador).
//   - Limpeza de dados (Administração, só o administrador): apagar semanas, aprovações e histórico é só do
//     administrador; Segurança (seginter, seganom, segfotos) também. Equipamentos (eqlanc, eqpar, eqinsp) seguem como
//     antes: quem lança na Operação apaga o próprio lançamento um a um (o administrador também).
//   - Fotos das atividades (evidencias, evidenciasArquivo e b_): cria quem aponta na área, em nome próprio; lê quem lê
//     as semanas; o autor só ajusta refs (24 h); exportação/lixeira/remoção e apagar = administrador; config/fotos =
//     administrador. Parte 2 (Relatórios e arquivo de fotos): lixeira só da foto exportada; a foto completa só sai do
//     banco junto da marca removidaEm (e só da que está na lixeira). Veja o bloco "Fotos das atividades" abaixo e
//     docs/fotos-atividades.md.
//   - Segurança (seginter, seganom, segfotos, config/seguranca) = perfil da Segurança (registra, trata, gestor, leitor)
//     e o supervisor da área (Operação · Supervisor numa área do conjunto da anomalia). Veja o bloco Segurança abaixo.
// TRANSIÇÃO: cadastro sem o campo acesso usa as regras de antes (papel único + modulos), como alternativa.
// Perfis antigos: admin, gestor, coordenador, supervisor (até 2 áreas: area e area2), lider (1 área),
// administrativo, leitor, bloqueado. A tela Usuários continua gravando também os campos antigos (papel, modulos).
// A Bateria usa as mesmas coleções do Pátio com o prefixo b_.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function uref() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function hasProfile() { return signed() && exists(uref()); }
    function perfil() { return get(uref()).data; }
    function ativo() { return hasProfile() && perfil().papel in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'administrativo', 'leitor']; }
    // ---- Acesso por módulo ----
    function nvU(u) { return 'acesso' in u; }                                       // cadastro já no modelo novo
    function pmU(u, m) { return u.get('acesso', {}).get(m, ''); }                    // perfil no módulo ('' = sem acesso)
    function escU(u, e) { return e in u.get('escopos', []); }
    function adminU(u) { return u.papel == 'admin' || (u.papel != 'bloqueado' && nvU(u) && pmU(u, 'administracao') == 'admin'); }
    function nv() { return nvU(perfil()); }
    function pEm(m) { return pmU(perfil(), m); }
    function esc(e) { return escU(perfil(), e); }
    // Pátio → módulo antigo 'operacao'; Bateria → 'bateria' (para a regra de antes).
    function modDe(e) { return e == 'patio' ? 'operacao' : e; }
    function admin() { return hasProfile() && adminU(perfil()); }
    function gestor() { return hasProfile() && perfil().papel in ['gestor', 'coordenador', 'supervisor', 'lider']; }   // quem aponta (antigo)
    function todasAreas() { return hasProfile() && perfil().papel in ['gestor', 'coordenador']; }
    function minhaArea(area) { return perfil().get('area', '') == area || (perfil().papel == 'supervisor' && perfil().get('area2', '') == area); }
    // Área no perfil de um módulo: líder 1 área; supervisor também a 2ª; gestor e coordenador todas.
    function areaEm(p, area) { return p in ['gestor', 'coordenador'] || (p in ['supervisor', 'lider'] && (perfil().get('area', '') == area || (p == 'supervisor' && perfil().get('area2', '') == area))); }
    function mods() { return perfil().get('modulos', ['operacao']); }
    // Administração dos módulos: administrador; ou 'Dos módulos' sendo Gestor (Gestão) no escopo — Equipamentos aceita
    // também o Gestor da Operação; as Fichas pedem a Gestão com as Fichas.
    function admModNovo(m) {
      return pEm('administracao') == 'modulo' && (
        (m == 'operacao' && pEm('gestao') == 'gestor' && esc('patio'))
        || (m == 'bateria' && pEm('gestao') == 'gestor' && esc('bateria'))
        || (m == 'equipamentos' && (pEm('gestao') == 'gestor' || pEm('operacao') == 'gestor') && esc('equipamentos'))
        || (m == 'gestao' && pEm('gestao') == 'gestor' && 'gestao' in mods()));
    }
    function admMod(m) { return admin() || (ativo() && (nv() ? admModNovo(m) : (acOp() && perfil().papel == 'gestor' && m in mods()))); }   // administração do módulo
    // Acessos antigos (portas de entrada): operacao (padrão de quem não tem o campo), administrativo.
    function acessos() { return perfil().get('acessos', ['operacao']); }
    function acOp() { return admin() || 'operacao' in acessos() || 'administrativo' in acessos(); }
    // RH: Frequência e férias (ler) e quem grava (Administrativo).
    function acAdm() { return ativo() && (admin() || (nv() ? pEm('rh') != '' : (perfil().papel == 'administrativo' || 'frequencia' in mods() || 'administrativo' in acessos()))); }
    function admEdita() { return acAdm() && (admin() || (nv() ? pEm('rh') == 'administrativo' : perfil().papel != 'leitor')); }
    // Lê as Atividades de um conjunto (e = patio | bateria): Operação ou Gestão com o escopo.
    function lePB(e) { return ativo() && (admin() || (nv() ? ((pEm('operacao') != '' || pEm('gestao') != '') && esc(e)) : (acOp() && modDe(e) in mods()))); }
    function op() { return lePB('patio'); }        // Atividades Pátio
    function ba() { return lePB('bateria'); }      // Atividades Bateria
    function ge() { return hasProfile() && geU(perfil()); }          // Fichas (Gestão)
    // Equipamentos: ler = escopo Equipamentos com Operação ou Gestão; gravar = Operação (líder a gestor).
    function eqm() { return ativo() && (admin() || (nv() ? ((pEm('operacao') != '' || pEm('gestao') != '') && esc('equipamentos')) : (acOp() && 'equipamentos' in mods()))); }
    function eqEdita() { return eqm() && (admin() || (nv() ? pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider'] : perfil().papel in ['gestor', 'coordenador', 'supervisor', 'lider'])); }
    // Avaliação mensal (fica na Gestão): também quem lança pela Gestão.
    function eqAvalEdita() { return eqEdita() || (eqm() && nv() && pEm('gestao') in ['gestor', 'coordenador', 'supervisor', 'lider']); }
    function geEdita() { return hasProfile() && geEditaU(perfil()); }
    // Aponta e lança a presença na área (Operação · líder a gestor, com o escopo).
    function apontaDa(area, e) { return nv() ? (ativo() && esc(e) && pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider'] && areaEm(pEm('operacao'), area))
      : (gestor() && acOp() && modDe(e) in mods() && (todasAreas() || minhaArea(area))); }
    function gestorDa(area) { return apontaDa(area, 'patio'); }
    function gestorDaB(area) { return apontaDa(area, 'bateria'); }
    // Atividade fora da programação (campo fp da semana): só coordenador e supervisor da área (e o administrador).
    function criaFora(area, e) { return apontaDa(area, e) && (nv() ? pEm('operacao') in ['coordenador', 'supervisor'] : perfil().papel in ['coordenador', 'supervisor']); }
    function criaForaDa(area) { return criaFora(area, 'patio'); }
    function criaForaDaB(area) { return criaFora(area, 'bateria'); }
    // Presença do dia (situacao): quem aponta no conjunto (Operação), o RH (Administrativo) e o administrador.
    function lancaSit(e) { return admin() || admEdita() || (nv() ? (ativo() && esc(e) && pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider']) : (gestor() && modDe(e) in mods() && acOp())); }
    // Efetivo por área: administrador, gestor, coordenador, administrativo e somente leitura veem todas as áreas;
    // supervisor, as 2 dele; líder, a dele; quem tem o escopo Equipamentos, também os operadores.
    function todasFichas() { return hasProfile() && todasFichasU(perfil()); }
    function minhaFicha(area) { return hasProfile() && minhaFichaU(perfil(), area); }
    // As mesmas contas, recebendo o perfil já lido (u): cada regra lê o perfil uma vez só e fica dentro do limite
    // de expressões do Firestore. No modelo novo, vale o perfil da Gestão e as Fichas (gestao em modulos).
    function pgU(u) { return adminU(u) ? 'admin' : (nvU(u) ? pmU(u, 'gestao') : u.papel); }   // perfil nas fichas
    function geU(u) { return u.papel in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'administrativo', 'leitor']
      && (adminU(u) || (nvU(u) ? (pmU(u, 'gestao') != '' && 'gestao' in u.get('modulos', [])) : ('operacao' in u.get('acessos', ['operacao']) && 'gestao' in u.get('modulos', ['operacao'])))); }
    function geEditaU(u) { return geU(u) && pgU(u) in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'administrativo']; }
    function todasFichasU(u) { return geU(u) && pgU(u) in ['admin', 'gestor', 'coordenador', 'administrativo', 'leitor']; }
    function minhaAreaU(u, area) { return u.get('area', '') == area || (pgU(u) == 'supervisor' && u.get('area2', '') == area); }
    function minhaFichaU(u, area) { return geU(u) && (minhaAreaU(u, area) || (area == 'OPERAÇÃO DE EQUIPAMENTOS' && (nvU(u) ? escU(u, 'equipamentos') : 'equipamentos' in u.get('modulos', ['operacao'])))); }
    function admGestaoU(u) { return adminU(u) || (nvU(u) ? (pmU(u, 'administracao') == 'modulo' && pmU(u, 'gestao') == 'gestor' && 'gestao' in u.get('modulos', []))
      : (u.papel == 'gestor' && 'operacao' in u.get('acessos', ['operacao']) && 'gestao' in u.get('modulos', ['operacao']))); }
    function veOcorrU(u, o) { return todasFichasU(u) || (geU(u) && (minhaFichaU(u, o.area) || o.criadoPor == request.auth.uid || o.recolhe == u.get('nomeUp', '#'))); }
    // Perfil no módulo (para Segurança e para os testes): null/'' = sem acesso.
    function perfilEm(mod) { return pEm(mod); }
    function temMod(mod) { return hasProfile() && perfil().papel != 'bloqueado' && pEm(mod) != ''; }
    function perfilEmEntre(mod, perfis) { return temMod(mod) && perfilEm(mod) in perfis; }
    function temEscopo(e) { return hasProfile() && esc(e); }
    function soAltera(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // Marca que o sistema já tem administrador (a tela de login lê para saber o que mostrar).
    // Ninguém grava pelo site: o administrador é criado ou recuperado pela rotina do GitHub
    // "Administrador do sistema", que usa a chave de serviço (não passa por estas regras).
    match /config/bootstrap {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Dados das planilhas originais para a importação (pasta dados-importacao do repositório).
    // A publicação grava com a chave de serviço; só a administração do módulo correspondente lê.
    match /seeds/{nome} {
      allow get: if (nome == 'seed' && admMod('operacao'))
        || (nome == 'seed-bateria' && admMod('bateria'))
        || (nome == 'seed-equip' && admMod('equipamentos'))
        || (nome in ['seed-gestao', 'seed-efetivo'] && admMod('gestao'))
        || (nome in ['seed-freq-patio', 'seed-freq-bateria', 'seed-ferias'] && admin());
      allow list, create, update, delete: if false;
    }

    match /config/sistema {
      allow read: if op();
      allow write: if admMod('operacao');
    }

    // Liga o usuário digitado na tela de login à conta interna. Leitura pública só de um item por vez.
    match /logins/{login} {
      allow get: if true;
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    // Só o administrador cadastra pessoas. A própria pessoa só grava trocarSenha e ultimoAcesso: papel, áreas, módulos,
    // abas e o acesso por módulo (acesso, escopos) ficam só com o administrador.
    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create: if admin();
      allow update: if admin()
        || (request.auth.uid == uid && soAltera(['trocarSenha', 'ultimoAcesso'])
            && request.resource.data.get('trocarSenha', false) == false);
      allow delete: if admin();
    }

    match /plano/{area} {
      allow read: if op();
      allow write: if admMod('operacao');
    }

    match /colaboradores/{area} {
      allow read: if op() || acAdm();
      allow write: if admMod('operacao') || admMod('gestao');
    }

    // Presença do dia: a mesma para a Operação (Efetivo diário) e o Administrativo (Frequência).
    match /situacao/{mes} {
      allow read: if op() || acAdm() || eqm();   // Equipe e frota usa a mesma presença
      allow write: if lancaSit('patio');
    }

    // Apagar semanas e aprovações (Limpeza de dados) e o histórico: só o administrador. A dispensa das pendências
    // antigas (célula volta a '_' e a marca vai em dx) é uma alteração: o administrador já altera a semana inteira.
    // O mesmo vale para o feriado sem operação (célula volta a '_' e a marca vai em fe; public/feriados.js): grava o
    // administrador (Escalas e turnos) ou a rotina do GitHub (chave de serviço, que não passa por estas regras).
    // ft = quantas fotos cada célula tem (sobe no mesmo lote que grava a foto; veja Fotos das atividades abaixo).
    match /semanas/{id} {
      allow read: if op();
      allow create: if admMod('operacao');
      allow delete: if admin();
      allow update: if admMod('operacao') || (gestorDa(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'atualizadoEm', 'atualizadoPor']))
        || (criaForaDa(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'fp', 'atualizadoEm', 'atualizadoPor']));
    }

    // Aprovação dos apontamentos: o supervisor da área aprova ou devolve o que foi apontado; o administrador é a reserva.
    // Administrador: aprovador reserva (a tela só oferece nas áreas sem supervisor).
    function aprova(area, e) { return (apontaDa(area, e) && (nv() ? pEm('operacao') == 'supervisor' : perfil().papel == 'supervisor')) || admin(); }
    function aprovaDa(area) { return aprova(area, 'patio'); }
    // Plano de ação das causas: supervisor na área dele; coordenador, gestor e administrador também. Pela Operação
    // ou pela Gestão (a tela Causas e ações fica na Gestão).
    function acompanha(area, e) { return admin() || (nv() ? (ativo() && esc(e) && ((pEm('operacao') in ['gestor', 'coordenador', 'supervisor'] && areaEm(pEm('operacao'), area)) || (pEm('gestao') in ['gestor', 'coordenador', 'supervisor'] && areaEm(pEm('gestao'), area))))
      : (apontaDa(area, e) && perfil().papel in ['gestor', 'coordenador', 'supervisor'])); }
    function acompanhaDa(area) { return acompanha(area, 'patio'); }
    match /aprov/{id} {
      allow read: if op();
      allow create, update: if aprovaDa(request.resource.data.area) && (resource == null || resource.data.area == request.resource.data.area);
      allow delete: if admin();
    }

    // Plano de ação das causas de não realização: quem aprova na área (ou em todas, area 'TODAS') cria e acompanha.
    function acaoOk(d) { return d.area is string && d.causa is string && d.causa.size() <= 160 && d.acao is string && d.acao.size() <= 400; }
    function acaoTodas(e) { return admin() || (nv() ? (ativo() && esc(e) && (pEm('operacao') in ['gestor', 'coordenador'] || pEm('gestao') in ['gestor', 'coordenador'])) : (todasAreas() && acOp() && modDe(e) in mods())); }
    function acaoPode(area, m) { return area == 'TODAS' ? acaoTodas(m == 'operacao' ? 'patio' : 'bateria') : (m == 'operacao' ? acompanhaDa(area) : acompanhaDaB(area)); }
    match /acoes/{id} {
      allow read: if op();
      allow create: if acaoOk(request.resource.data) && acaoPode(request.resource.data.area, 'operacao');
      allow update: if acaoOk(request.resource.data) && resource.data.area == request.resource.data.area && acaoPode(resource.data.area, 'operacao');
      allow delete: if admMod('operacao');
    }
    match /b_acoes/{id} {
      allow read: if ba();
      allow create: if acaoOk(request.resource.data) && acaoPode(request.resource.data.area, 'bateria');
      allow update: if acaoOk(request.resource.data) && resource.data.area == request.resource.data.area && acaoPode(resource.data.area, 'bateria');
      allow delete: if admMod('bateria');
    }

    // ---------- Fotos das atividades (evidencias/evidenciasArquivo; Bateria com o prefixo b_) ----------
    // Um documento leve por foto (miniatura e dados da atividade; refs = as atividades que a foto comprova) e o arquivo
    // completo com o mesmo id, gravados no mesmo lote do apontamento (data.js › apontarComFotos). Modelo completo em
    // docs/fotos-atividades.md.
    // - Criar: quem aponta na área (a mesma regra do apontamento) ou o administrador, em nome próprio, com os campos
    //   obrigatórios, miniatura até 40 mil caracteres e arquivo até 900 mil; a área tem de ser a da semana; o arquivo só
    //   entra junto do documento leve (getAfter), e os campos de exportação/lixeira/remoção nascem vazios.
    // - Ler: quem lê as semanas do conjunto (Operação ou Gestão com o escopo).
    // - Alterar: o autor só ajusta refs, até 24 h depois da foto e se ainda aponta na área; o administrador ajusta refs
    //   e os campos de exportação, lixeira e remoção (Parte 2). Nada mais muda.
    // - Parte 2 (Administração › Relatórios e arquivo de fotos), só o administrador:
    //   exportadoEm (hora) + exportLote (até 60 caracteres) + exportConf (conferência do SHA-256: ok, divergente,
    //   sem-sha) ao confirmar o .zip salvo; lixeiraEm (hora) só na foto já exportada (restaurar = lixeiraEm null);
    //   removidaEm (hora) só na foto que está na lixeira, no MESMO lote que apaga a foto completa (evidenciasArquivo).
    //   Depois de removida, a foto não volta: removidaEm, lixeiraEm e exportadoEm ficam como estão.
    // - Apagar o documento leve: só o administrador. Apagar a foto completa (evidenciasArquivo): só o administrador e só
    //   junto da marca removidaEm numa foto exportada (ou junto com o documento leve).
    function fotoCampos() { return ['refs', 'semana', 'area', 'conj', 'pid', 'k', 'dia', 'mes', 'rota', 'sit', 'local', 'ativ', 'nome', 'tipo', 'tamanho',
      'bytes', 'w', 'h', 'sha', 'thumb', 'por', 'porNome', 'at', 'exportadoEm', 'exportLote', 'exportConf', 'lixeiraEm', 'removidaEm']; }
    function fotoOk(d, col) {
      return d.keys().hasOnly(fotoCampos()) && d.keys().hasAll(['refs', 'semana', 'area', 'k', 'dia', 'mes', 'thumb', 'por', 'at', 'bytes', 'w', 'h', 'sha'])
        && d.por == request.auth.uid && d.at == request.time
        && d.refs is list && d.refs.size() >= 1 && d.refs.size() <= 100
        && d.semana is string && d.area is string && d.k is int && d.k >= 0 && d.k <= 6
        && d.dia is string && d.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.mes == d.dia.split('-')[0] + '-' + d.dia.split('-')[1]
        && d.thumb is string && d.thumb.size() <= 40000
        && d.bytes is int && d.bytes > 0 && d.bytes <= 700000 && d.w is int && d.h is int
        && d.sha is string && (d.sha == '' || d.sha.matches('[0-9a-f]{64}'))
        && d.get('ativ', '') is string && d.get('ativ', '').size() <= 600 && d.get('local', '') is string && d.get('local', '').size() <= 400
        && d.get('exportadoEm', null) == null && d.get('exportLote', null) == null && d.get('exportConf', null) == null && d.get('lixeiraEm', null) == null && d.get('removidaEm', null) == null
        && get(/databases/$(database)/documents/$(col)/$(d.semana)).data.area == d.area;
    }
    function arqOk(d, col, id) {
      let leve = getAfter(/databases/$(database)/documents/$(col)/$(id)).data;
      return d.keys().hasOnly(['area', 'semana', 'dia', 'sha', 'por', 'dados']) && d.por == request.auth.uid
        && d.dados is string && d.dados.size() <= 900000 && d.area is string
        && leve.por == request.auth.uid && leve.area == d.area;
    }
    function fotoAutor(e) {
      return resource.data.por == request.auth.uid && apontaDa(resource.data.area, e) && soAltera(['refs', 'atualizadoEm', 'atualizadoPor'])
        && request.time < resource.data.at + duration.value(24, 'h');
    }
    function fotoAdmin() {
      let d = request.resource.data;
      let antes = resource.data;
      return admin() && soAltera(['refs', 'exportadoEm', 'exportLote', 'exportConf', 'lixeiraEm', 'removidaEm', 'atualizadoEm', 'atualizadoPor'])
        && (d.get('exportadoEm', null) == null || d.get('exportadoEm', null) is timestamp)
        && (d.get('exportLote', null) == null || (d.get('exportLote', null) is string && d.get('exportLote', null).size() <= 60))
        && d.get('exportConf', null) in [null, 'ok', 'divergente', 'sem-sha']
        && (d.get('lixeiraEm', null) == null || (d.get('lixeiraEm', null) is timestamp && d.get('exportadoEm', null) != null))
        && (d.get('removidaEm', null) == null || (d.get('removidaEm', null) is timestamp && d.get('lixeiraEm', null) != null))
        && (antes.get('removidaEm', null) == null || (d.get('removidaEm', null) == antes.get('removidaEm', null)
          && d.get('lixeiraEm', null) == antes.get('lixeiraEm', null) && d.get('exportadoEm', null) == antes.get('exportadoEm', null)));
    }
    function refsOk(d) { return d.refs is list && d.refs.size() >= 1 && d.refs.size() <= 100; }
    // Foto do código antigo (só o campo ref, sem refs): o administrador marca exportação/lixeira sem criar refs.
    function refsOuAntiga(d) { return refsOk(d) || (!('refs' in d) && !('refs' in resource.data)); }
    // A foto completa só sai junto da marca removidaEm (foto exportada) ou junto com o documento leve.
    // Cada foto custa uma leitura (getAfter do leve): o lote de "apagar de vez" tem até 15 fotos, porque o Firestore
    // aceita no máximo 20 documentos lidos pelas regras num lote (fotos-arquivo.js › LOTE).
    function arqApagavel(col, id) {
      return admin() && (!existsAfter(/databases/$(database)/documents/$(col)/$(id))
        || (getAfter(/databases/$(database)/documents/$(col)/$(id)).data.get('removidaEm', null) != null
          && getAfter(/databases/$(database)/documents/$(col)/$(id)).data.get('exportadoEm', null) != null));
    }
    match /evidencias/{id} {
      allow read: if op();
      allow create: if (admin() || gestorDa(request.resource.data.area)) && fotoOk(request.resource.data, 'semanas');
      allow update: if (fotoAutor('patio') && refsOk(request.resource.data)) || (fotoAdmin() && refsOuAntiga(request.resource.data));
      allow delete: if admin();
    }
    match /evidenciasArquivo/{id} {
      allow read: if op();
      allow create: if (admin() || gestorDa(request.resource.data.area)) && arqOk(request.resource.data, 'evidencias', id);
      allow update: if false;
      allow delete: if arqApagavel('evidencias', id);
    }
    // Configuração das fotos: todos os ativos leem; só o administrador grava (com os limites conferidos).
    match /config/fotos {
      allow read: if ativo();
      allow write: if admin() && request.resource.data.keys().hasOnly(['obrig', 'min', 'max', 'situacoes', 'desde', 'atualizadoEm', 'por'])
        && request.resource.data.obrig is bool && request.resource.data.min is int && request.resource.data.max is int
        && request.resource.data.min >= 0 && (request.resource.data.obrig == false || request.resource.data.min >= 1) && request.resource.data.max >= request.resource.data.min
        && request.resource.data.max >= 1 && request.resource.data.max <= 10
        && request.resource.data.situacoes is list && request.resource.data.situacoes.hasOnly(['R', 'E', 'N'])
        && (!request.resource.data.obrig || request.resource.data.situacoes.size() >= 1);
    }

    // ---------- Módulo Atividades Bateria (mesma estrutura do Pátio, prefixo b_) ----------
    match /b_config/sistema {
      allow read: if ba();
      allow write: if admMod('bateria');
    }
    match /b_plano/{area} {
      allow read: if ba();
      allow write: if admMod('bateria');
    }
    match /b_colaboradores/{area} {
      allow read: if ba() || acAdm();
      allow write: if admMod('bateria') || admMod('gestao');
    }
    match /b_situacao/{mes} {
      allow read: if ba() || acAdm() || eqm();
      allow write: if lancaSit('bateria');
    }
    match /b_semanas/{id} {
      allow read: if ba();
      allow create: if admMod('bateria');
      allow delete: if admin();
      allow update: if admMod('bateria') || (gestorDaB(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'atualizadoEm', 'atualizadoPor']))
        || (criaForaDaB(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'fp', 'atualizadoEm', 'atualizadoPor']));
    }
    // Administrador: aprovador reserva (a tela só oferece nas áreas sem supervisor).
    function aprovaDaB(area) { return aprova(area, 'bateria'); }
    function acompanhaDaB(area) { return acompanha(area, 'bateria'); }
    match /b_aprov/{id} {
      allow read: if ba();
      allow create, update: if aprovaDaB(request.resource.data.area) && (resource == null || resource.data.area == request.resource.data.area);
      allow delete: if admin();
    }
    match /b_evidencias/{id} {
      allow read: if ba();
      allow create: if (admin() || gestorDaB(request.resource.data.area)) && fotoOk(request.resource.data, 'b_semanas');
      allow update: if (fotoAutor('bateria') && refsOk(request.resource.data)) || (fotoAdmin() && refsOuAntiga(request.resource.data));
      allow delete: if admin();
    }
    match /b_evidenciasArquivo/{id} {
      allow read: if ba();
      allow create: if (admin() || gestorDaB(request.resource.data.area)) && arqOk(request.resource.data, 'b_evidencias', id);
      allow update: if false;
      allow delete: if arqApagavel('b_evidencias', id);
    }

    // ---------- Módulo Operação: controle de equipamentos ----------
    match /eq/{docId} {
      allow read: if eqm();
      allow write: if admMod('equipamentos') || (docId == 'cadastro' && (eqEdita() || admMod('gestao')));
    }
    // Lançamentos: quem tem a Frequência também lê, porque a hora extra da Operação entra na folha.
    match /eqlanc/{id} { allow read: if eqm() || acAdm(); allow create, update, delete: if eqEdita(); }
    match /eqpar/{id} { allow read: if eqm(); allow create, update, delete: if eqEdita(); }
    match /eqinsp/{id} { allow read: if eqm(); allow create, update, delete: if eqEdita(); }
    match /eqaval/{mes} { allow read: if eqm(); allow write: if eqAvalEdita(); }

    // ---------- Módulo Efetivo: fichas de acompanhamento ----------
    // gestao/config: tipos de ocorrência e texto da ficha (todos do Efetivo). gestao/colaboradores: lista antiga,
    // de antes da divisão por área (só quem vê todas as áreas; é apagada na migração).
    match /gestao/{docId} {
      allow read: if ge() && (docId != 'colaboradores' || todasFichas());
      allow write: if admMod('gestao');
    }
    // Fichas dos colaboradores, um documento por área.
    match /gcolab/{area} {
      allow read: if todasFichas() || minhaFicha(area) || acAdm();
      allow write: if admMod('gestao');
    }
    // Ocorrências: da área, ou registradas pela pessoa, ou que ela vai recolher (recolhe = nome em maiúsculas,
    // comparado com usuarios/{uid}.nomeUp, que o sistema grava no cadastro).
    function veOcorr(o) { return hasProfile() && veOcorrU(perfil(), o); }
    function mudaOcorr(o) {
      let u = perfil();
      return admGestaoU(u) || (geEditaU(u) && veOcorrU(u, o) && soAltera(['status', 'assinadoEm', 'assinaturaId', 'metodo', 'testemunha', 'recolhe']));
    }
    match /gocorr/{id} {
      allow read: if veOcorr(resource.data);
      allow create: if geEdita() && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.area is string && (todasFichas() || minhaFicha(request.resource.data.area));
      allow update: if hasProfile() && mudaOcorr(resource.data);
      allow delete: if admMod('gestao');
    }
    // Assinaturas: não mudam depois de gravadas (a administração só acerta a área quando a pessoa muda de área).
    match /gassin/{id} {
      allow read: if todasFichas() || (ge() && (minhaFicha(resource.data.area) || resource.data.por == request.auth.uid));
      allow create: if geEdita() && request.resource.data.por == request.auth.uid && request.resource.data.area is string;
      allow update: if admMod('gestao') && soAltera(['area']);
      allow delete: if admin();
    }

    // Escala de turno (regimes, turmas e feriados) usada por todos os módulos. Todos leem; administrador e gestor alteram.
    match /config/escalas {
      allow read: if ativo();
      allow write: if admin() || (ativo() && (nv() ? (pEm('administracao') == 'modulo' && (pEm('gestao') == 'gestor' || pEm('operacao') == 'gestor')) : perfil().papel == 'gestor'));
    }

    // Abas que cada perfil vê (tela Perfis e permissões). Todos leem; só o administrador muda.
    // A exceção por pessoa fica no campo abas de usuarios/{uid}, que só o administrador altera.
    match /config/permissoes {
      allow read: if ativo();
      allow write: if admin();
    }

    // Avisos no celular: chave pública do Web Push (config/avisos) e os aparelhos/preferências de cada pessoa.
    match /config/avisos {
      allow read: if ativo();
      allow write: if admin();
    }
    // Resultado da última execução da rotina de avisos (gravado pela rotina; o administrador acompanha no Meu dia).
    match /avisos_enviados/{docId} {
      allow get: if admin();
    }
    match /avisos/{uid} {
      allow read, write: if ativo() && request.auth.uid == uid;
      allow read: if admin();
    }

    // Ponte com o Senior: a rotina do GitHub grava com a chave de serviço; só o administrador lê e marca como aplicado.
    match /integracao/{docId} {
      allow read: if admin();
      allow update: if admin() && soAltera(['aplicadoEm', 'aplicadoPor']);
    }

    // ---------- Acesso Administrativo ----------
    // Folha de frequência de cada competência (16 a 15): grupos, pessoas e os dias de quem não está nas Atividades.
    // Quem está nas Atividades tem a presença em situacao/b_situacao (a mesma do Efetivo diário).
    match /freqcomp/{id} {
      allow read: if acAdm() || eqm();   // Equipe e frota (Operação) lê a folha para a situação dos operadores
      allow write: if admEdita();
    }
    // Férias: um documento por período.
    match /ferias/{id} {
      allow read: if acAdm();
      allow write: if admEdita();
    }
    // adm/feriasAtivas: resumo das férias de agora e dos próximos meses, lido pela Operação (marca FE sozinho).
    match /adm/{docId} {
      allow read: if ativo();
      allow write: if admEdita();
    }
    // Uso do plano grátis (gravado pela rotina do GitHub; o administrador acompanha).
    match /sistema/{docId} {
      allow read: if admin();
      allow write: if false;
    }

    // ---------- Módulo Segurança: registros de interação e de anomalia ----------
    // Só registra quem o administrador autorizou (Segurança · registra, trata ou gestor). Quem só registra lê só o que
    // registrou; trata, gestor, somente leitura e o administrador leem tudo. O supervisor da área (Operação · Supervisor
    // com a área dele, area ou area2, dentro do conjunto da anomalia: conj = patio | bateria) lê e trata as anomalias e
    // lê as interações da área. O acompanhamento (status, trat, conclEm) é de quem trata e do supervisor da área; o autor
    // corrige o próprio registro por 24 h (a anomalia, só enquanto aberta). Apagar = administrador. As fotos (segfotos)
    // levam o autor e o conjunto do registro e seguem as mesmas regras de leitura.
    function segP() { return pEm('seguranca'); }
    function segRegistra() { return admin() || (ativo() && nv() && segP() in ['registra', 'trata', 'gestor']); }
    function segTudo() { return admin() || (ativo() && nv() && segP() in ['trata', 'gestor', 'leitor']); }
    function segTrata() { return admin() || (ativo() && nv() && segP() in ['trata', 'gestor']); }
    function areasDoConj(conj) { return conj == 'patio' ? ['RECEBIMENTO', 'FINAL DO PÁTIO', 'PREPARAÇÃO', 'TRATAMENTO DE COQUE'] : ['BATERIA 1', 'BATERIA 2', 'TRILHO', 'CDQ']; }
    function supSeg(conj) {
      return conj in ['patio', 'bateria'] && ativo()
        && (nv() ? (pEm('operacao') == 'supervisor' && esc(conj)) : (perfil().papel == 'supervisor' && acOp() && modDe(conj) in mods()))
        && (perfil().get('area', '') in areasDoConj(conj) || perfil().get('area2', '') in areasDoConj(conj));
    }
    function segLe(r) { return segTudo() || (r.por == request.auth.uid && segRegistra()) || supSeg(r.conj); }
    function txtOk(d, k, min, max) { return d.get(k, '') is string && d.get(k, '').size() >= min && d.get(k, '').size() <= max; }
    function dataOk(d) { return d.data is string && d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.mes == d.data.split('-')[0] + '-' + d.data.split('-')[1]; }
    function regOk(d) {
      return dataOk(d) && txtOk(d, 'area', 1, 60) && d.get('conj', '') in ['patio', 'bateria', '']
        && d.conj is string && txtOk(d, 'local', 1, 120) && txtOk(d, 'mat', 1, 30) && d.get('fotos', []) is list && d.get('minis', []) is list
        && d.get('fotos', []).size() <= 6 && d.get('minis', []).size() <= 6 && d.por is string && txtOk(d, 'porNome', 0, 120);
    }
    function interOk(d) {
      return regOk(d) && d.keys().hasOnly(['data', 'mes', 'area', 'conj', 'local', 'tipoAtiv', 'risco', 'desvios', 'desvioOutro', 'desc', 'acao', 'resp', 'mat', 'fotos', 'minis', 'por', 'porNome', 'em', 'atualizadoEm'])
        && txtOk(d, 'tipoAtiv', 1, 40) && txtOk(d, 'risco', 0, 500) && d.get('desvios', []) is list && d.get('desvios', []).size() <= 40
        && txtOk(d, 'desvioOutro', 0, 200) && txtOk(d, 'desc', 0, 3000) && txtOk(d, 'acao', 0, 3000) && txtOk(d, 'resp', 1, 120);
    }
    function anomOk(d) {
      return regOk(d) && d.keys().hasOnly(['data', 'hora', 'mes', 'area', 'conj', 'local', 'regime', 'desc', 'conseq', 'acao', 'causas', 'sugest', 'comunic', 'mat', 'fotos', 'minis', 'por', 'porNome', 'em', 'status', 'trat', 'conclEm', 'atualizadoEm', 'atualizadoPor'])
        && d.hora is string && d.hora.matches('[0-9]{2}:[0-9]{2}') && txtOk(d, 'regime', 1, 40)
        && txtOk(d, 'desc', 1, 3000) && txtOk(d, 'conseq', 1, 3000) && txtOk(d, 'acao', 1, 3000) && txtOk(d, 'causas', 1, 3000)
        && txtOk(d, 'sugest', 1, 3000) && txtOk(d, 'comunic', 1, 120) && d.status in ['aberta', 'tratamento', 'concluida'];
    }
    // Acompanhamento: situação, responsável, prazo, comentário, foto do depois (obrigatória para concluir) e histórico.
    function tratOk(d) {
      let t = d.get('trat', {});
      return d.status in ['aberta', 'tratamento', 'concluida'] && t is map
        && t.keys().hasOnly(['resp', 'respUid', 'prazo', 'coment', 'fotoDepois', 'miniDepois', 'hist'])
        && t.get('resp', '') is string && t.get('resp', '').size() <= 120 && t.get('coment', '') is string && t.get('coment', '').size() <= 3000
        && t.get('prazo', '') is string && t.get('hist', []) is list && t.get('hist', []).size() <= 150
        && t.get('miniDepois', '') is string && t.get('miniDepois', '').size() < 80000
        && (d.status != 'concluida' || (t.get('fotoDepois', '') is string && t.get('fotoDepois', '') != ''))
        && d.get('conclEm', '') is string;
    }
    // Campos que o autor corrige (o resto não muda).
    function corrige(col) {
      return col == 'seginter'
        ? soAltera(['data', 'mes', 'area', 'conj', 'local', 'tipoAtiv', 'risco', 'desvios', 'desvioOutro', 'desc', 'acao', 'resp', 'mat', 'atualizadoEm'])
        : soAltera(['data', 'hora', 'mes', 'area', 'conj', 'local', 'regime', 'desc', 'conseq', 'acao', 'causas', 'sugest', 'comunic', 'mat', 'atualizadoEm']);
    }
    function autorNoPrazo() { return segRegistra() && resource.data.por == request.auth.uid && request.time < resource.data.em + duration.value(24, 'h'); }
    match /seginter/{id} {
      allow read: if segLe(resource.data);
      allow create: if segRegistra() && interOk(request.resource.data) && request.resource.data.por == request.auth.uid && request.resource.data.em == request.time;
      allow update: if autorNoPrazo() && corrige('seginter') && interOk(request.resource.data);
      allow delete: if admin();
    }
    match /seganom/{id} {
      allow read: if segLe(resource.data);
      allow create: if segRegistra() && anomOk(request.resource.data) && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time && request.resource.data.status == 'aberta' && !('trat' in request.resource.data);
      allow update: if ((segTrata() || supSeg(resource.data.conj)) && soAltera(['status', 'trat', 'conclEm', 'atualizadoEm', 'atualizadoPor']) && tratOk(request.resource.data))
        || (autorNoPrazo() && resource.data.status == 'aberta' && corrige('seganom') && anomOk(request.resource.data));
      allow delete: if admin();
    }
    // Fotos: uma por documento (até ~700 KB). 'antes' = do registro, gravada pelo autor junto com ele; 'depois' = do
    // tratamento, gravada por quem trata. autor e conj vêm do registro (conferidos com getAfter).
    function fotoRegOk(d) {
      let r = getAfter(/databases/$(database)/documents/$(d.col)/$(d.reg)).data;
      return r.por == d.autor && r.get('conj', '') == d.conj;
    }
    match /segfotos/{id} {
      allow read: if segTudo() || (resource.data.autor == request.auth.uid && segRegistra()) || supSeg(resource.data.conj);
      allow create: if request.resource.data.por == request.auth.uid && request.resource.data.col in ['seginter', 'seganom']
        && request.resource.data.reg is string && request.resource.data.dados is string && request.resource.data.dados.size() < 700000
        && request.resource.data.mini is string && request.resource.data.mini.size() < 80000 && request.resource.data.conj is string
        && ((request.resource.data.tipo == 'antes' && segRegistra() && request.resource.data.autor == request.auth.uid)
            || (request.resource.data.tipo == 'depois' && request.resource.data.col == 'seganom' && (segTrata() || supSeg(request.resource.data.conj))))
        && fotoRegOk(request.resource.data);
      allow update: if false;
      allow delete: if admin();
    }
    // Listas dos formulários (áreas, tipos de atividade, regimes e desvios): todos os ativos leem; o administrador e a
    // Administração 'Dos módulos' de quem é Gestor da Segurança alteram.
    match /config/seguranca {
      allow read: if ativo();
      allow write: if admin() || (ativo() && nv() && pEm('administracao') == 'modulo' && segP() == 'gestor');
    }

    // Painel Coqueria (repositório Gest-o-Eduardo, gestao-eduardo.web.app): espaço pessoal de cada usuário ativo (tarefas, Medição, Queda Zero).
    // Só a própria pessoa lê e grava; nem o administrador vê o painel dos outros.
    match /painel/{uid}/{document=**} {
      allow read, write: if ativo() && request.auth.uid == uid;
    }

    match /historico/{id} {
      allow read: if ativo();
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'nome', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if admin();   // Limpeza de dados (histórico antigo)
    }
  }
}
