rules_version = '2';
// Regras de segurança — Programação do Pátio de Carvão
// Perfis: admin (tudo), gestor (todas as áreas + administração dos módulos dele, menos usuários),
// coordenador (aponta em todas as áreas dos módulos dele), supervisor (até 2 áreas: area e area2),
// lider (1 área), leitor (só lê), bloqueado (sem acesso).
// Módulos por usuário (campo modulos em usuarios/{uid}): operacao = Atividades Pátio, bateria = Atividades Bateria,
// equipamentos = Operação, gestao = Efetivo. A Bateria usa as mesmas coleções do Pátio com o prefixo b_.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function uref() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function hasProfile() { return signed() && exists(uref()); }
    function perfil() { return get(uref()).data; }
    function ativo() { return hasProfile() && perfil().papel in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'leitor']; }
    function admin() { return hasProfile() && perfil().papel == 'admin'; }
    function gestor() { return hasProfile() && perfil().papel in ['gestor', 'coordenador', 'supervisor', 'lider']; }   // quem aponta
    function todasAreas() { return hasProfile() && perfil().papel in ['gestor', 'coordenador']; }
    function minhaArea(area) { return perfil().get('area', '') == area || (perfil().papel == 'supervisor' && perfil().get('area2', '') == area); }
    function mods() { return perfil().get('modulos', ['operacao']); }
    function admMod(m) { return admin() || (ativo() && perfil().papel == 'gestor' && m in mods()); }   // administração do módulo
    function op() { return ativo() && (admin() || 'operacao' in mods()); }        // módulo Operação
    function ge() { return ativo() && (admin() || 'gestao' in mods()); }          // módulo Gestão
    function eqm() { return ativo() && (admin() || 'equipamentos' in mods()); }   // módulo Operação (equipamentos)
    function eqEdita() { return eqm() && (admin() || perfil().papel in ['gestor', 'coordenador', 'supervisor', 'lider']); }
    function geEdita() { return ge() && (admin() || perfil().papel in ['gestor', 'coordenador', 'supervisor', 'lider']); }
    function gestorDa(area) { return gestor() && 'operacao' in mods() && (todasAreas() || minhaArea(area)); }
    function ba() { return ativo() && (admin() || 'bateria' in mods()); }        // módulo Atividades Bateria
    function gestorDaB(area) { return gestor() && 'bateria' in mods() && (todasAreas() || minhaArea(area)); }
    function soAltera(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function boot() { return /databases/$(database)/documents/config/bootstrap; }

    // Criação do primeiro administrador: só acontece uma vez.
    match /config/bootstrap {
      allow get: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/sistema {
      allow read: if op();
      allow write: if admMod('operacao');
    }

    // Liga o usuário digitado na tela de login à conta interna. Leitura pública só de um item por vez.
    match /logins/{login} {
      allow get: if true;
      allow list: if admin();
      allow create: if admin()
        || (signed() && !exists(boot()) && getAfter(boot()).data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow update, delete: if admin();
    }

    // Só o administrador cadastra pessoas.
    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create: if admin()
        || (signed() && request.auth.uid == uid && request.resource.data.papel == 'admin'
            && !exists(boot()) && getAfter(boot()).data.uid == request.auth.uid);
      allow update: if admin()
        || (request.auth.uid == uid && soAltera(['trocarSenha', 'ultimoAcesso'])
            && request.resource.data.get('trocarSenha', false) == false);
      allow delete: if admin();
    }

    match /plano/{area} {
      allow read: if op();
      allow write: if admMod('operacao');
    }

    match /colaboradores/{area} {
      allow read: if op();
      allow write: if admMod('operacao') || admMod('gestao');
    }

    match /situacao/{mes} {
      allow read: if op();
      allow write: if admin() || (gestor() && 'operacao' in mods());
    }

    match /semanas/{id} {
      allow read: if op();
      allow create, delete: if admMod('operacao');
      allow update: if admMod('operacao') || (gestorDa(resource.data.area) && soAltera(['s', 'm', 'ev', 'atualizadoEm', 'atualizadoPor']));
    }

    // Fotos e arquivos das atividades. A lista (com miniatura) é separada do arquivo completo.
    match /evidencias/{id} {
      allow read: if op();
      allow create: if (admin() || gestorDa(request.resource.data.area))
        && request.resource.data.por == request.auth.uid
        && request.resource.data.thumb.size() < 80000
        // no máximo 6 anexos por atividade em cada dia
        && get(/databases/$(database)/documents/semanas/$(request.resource.data.semana)).data.get('ev', {})
             .get(request.resource.data.pid + '|' + string(request.resource.data.k), 0) < 6;
      allow delete: if admMod('operacao') || (gestorDa(resource.data.area) && resource.data.por == request.auth.uid);
    }
    match /evidenciasArquivo/{id} {
      allow read: if op();
      allow create: if (admin() || gestorDa(request.resource.data.area))
        && request.resource.data.por == request.auth.uid
        && request.resource.data.dados.size() < 1000000;
      allow delete: if admMod('operacao') || (gestorDa(resource.data.area) && resource.data.por == request.auth.uid);
    }

    // ---------- Módulo Atividades Bateria (mesma estrutura do Pátio, prefixo b_) ----------
    match /b_config/sistema {
      allow read: if ba();
      allow write: if admMod('bateria');
    }
    match /b_plano/{area} {
      allow read: if ba();
      allow write: if admMod('bateria');
    }
    match /b_colaboradores/{area} {
      allow read: if ba();
      allow write: if admMod('bateria') || admMod('gestao');
    }
    match /b_situacao/{mes} {
      allow read: if ba();
      allow write: if admin() || (gestor() && 'bateria' in mods());
    }
    match /b_semanas/{id} {
      allow read: if ba();
      allow create, delete: if admMod('bateria');
      allow update: if admMod('bateria') || (gestorDaB(resource.data.area) && soAltera(['s', 'm', 'ev', 'atualizadoEm', 'atualizadoPor']));
    }
    match /b_evidencias/{id} {
      allow read: if ba();
      allow create: if (admin() || gestorDaB(request.resource.data.area))
        && request.resource.data.por == request.auth.uid
        && request.resource.data.thumb.size() < 80000
        && get(/databases/$(database)/documents/b_semanas/$(request.resource.data.semana)).data.get('ev', {})
             .get(request.resource.data.pid + '|' + string(request.resource.data.k), 0) < 6;
      allow delete: if admMod('bateria') || (gestorDaB(resource.data.area) && resource.data.por == request.auth.uid);
    }
    match /b_evidenciasArquivo/{id} {
      allow read: if ba();
      allow create: if (admin() || gestorDaB(request.resource.data.area))
        && request.resource.data.por == request.auth.uid
        && request.resource.data.dados.size() < 1000000;
      allow delete: if admMod('bateria') || (gestorDaB(resource.data.area) && resource.data.por == request.auth.uid);
    }

    // ---------- Módulo Operação: controle de equipamentos ----------
    match /eq/{docId} {
      allow read: if eqm();
      allow write: if admMod('equipamentos') || (docId == 'cadastro' && (eqEdita() || admMod('gestao')));
    }
    match /eqlanc/{id} { allow read: if eqm(); allow create, update, delete: if eqEdita(); }
    match /eqpar/{id} { allow read: if eqm(); allow create, update, delete: if eqEdita(); }
    match /eqinsp/{id} { allow read: if eqm(); allow create, update, delete: if eqEdita(); }
    match /eqaval/{mes} { allow read: if eqm(); allow write: if eqEdita(); }

    // ---------- Módulo Efetivo: fichas de acompanhamento ----------
    match /gestao/{docId} {
      allow read: if ge();
      allow write: if admMod('gestao');
    }
    match /gocorr/{id} {
      allow read: if ge();
      allow create: if geEdita() && request.resource.data.criadoPor == request.auth.uid;
      allow update: if admMod('gestao') || (geEdita() && soAltera(['status', 'assinadoEm', 'assinaturaId', 'metodo', 'testemunha']));
      allow delete: if admMod('gestao');
    }
    match /gassin/{id} {
      allow read: if ge();
      allow create: if geEdita() && request.resource.data.por == request.auth.uid;
      allow update: if false;
      allow delete: if admin();
    }

    // Abas que cada perfil vê (tela Perfis e permissões). Todos leem; só o administrador muda.
    // A exceção por pessoa fica no campo abas de usuarios/{uid}, que só o administrador altera.
    match /config/permissoes {
      allow read: if ativo();
      allow write: if admin();
    }

    // Avisos no celular: chave pública do Web Push (config/avisos) e os aparelhos/preferências de cada pessoa.
    match /config/avisos {
      allow read: if ativo();
      allow write: if admin();
    }
    match /avisos/{uid} {
      allow read, write: if ativo() && request.auth.uid == uid;
      allow read: if admin();
    }

    // Ponte com o Senior: a rotina do GitHub grava com a chave de serviço; só o administrador lê e marca como aplicado.
    match /integracao/{docId} {
      allow read: if admin();
      allow update: if admin() && soAltera(['aplicadoEm', 'aplicadoPor']);
    }

    match /historico/{id} {
      allow read: if ativo();
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'nome', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
