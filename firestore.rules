rules_version = '2';
// Regras de segurança — Dikma Gestão (Coqueria)
// ACESSO POR MÓDULO (usuarios/{uid}.acesso, a partir da fase 2 da divisão em 5 módulos):
//   acesso  = { operacao, gestao, seguranca, rh: perfil no módulo; administracao: 'admin' | 'modulo' }
//   escopos = parte de ['patio', 'bateria', 'equipamentos']; as Fichas de acompanhamento = 'gestao' em modulos.
//   Cada regra confere o perfil DO MÓDULO certo:
//   - Pátio/Bateria (semanas, aprov, plano, colaboradores, situacao, acoes): ler = Operação ou Gestão + escopo;
//     apontar e lançar a presença = Operação (líder a gestor) na área; aprovar = Operação · Supervisor na área,
//     Operação · Técnico de Processo em todas as áreas do escopo, e o administrador; ações das causas = Operação ou Gestão (supervisor para cima) na área.
//   - Plano, rotas, gerador = Administração: administrador, ou 'Dos módulos' com Gestão · Gestor no escopo.
//   - Equipamentos (eq*) = escopo Equipamentos: Operação grava; Gestão lê (e lança a Avaliação mensal).
//   - Fichas (gestao, gcolab, gocorr, gassin) = Gestão com as Fichas. O cadastro (gcolab) também é gravado pelo
//     RH · Administrativo (RH › Colaboradores).
//   - RH (freqcomp, ferias, adm) = RH: Administrativo grava, Somente leitura lê.
//   - Indicadores (acesso.indicadores = 've' | 'gestor'): SÓ LEITURA do que está por trás dos painéis, nos conjuntos do
//     escopo (Pátio, Bateria, Equipamentos): atividades, presença, equipamentos, frequência e férias, cadastro do RH,
//     registros da Segurança do conjunto e treinamentos. Nenhuma gravação passa por este perfil. Veja indE.
//   - Usuários, config/permissoes = Administração completa (administrador).
//   - Limpeza de dados (Administração, só o administrador): apagar semanas, aprovações e histórico é só do
//     administrador; Segurança (seginter, seganom, segcartao, seginsp, segfotos) também. Equipamentos (eqlanc, eqpar, eqinsp): o autor,
//     o supervisor para cima e o administrador apagam um a um (veja o bloco de equipamentos).
//   - Fotos das atividades (evidencias, evidenciasArquivo e b_): cria quem aponta na área, em nome próprio; lê quem lê
//     as semanas; o autor só ajusta refs (24 h); exportação/lixeira/remoção e apagar = administrador; config/fotos =
//     administrador. Parte 2 (Relatórios e arquivo de fotos): lixeira só da foto exportada; a foto completa só sai do
//     banco junto da marca removidaEm (e só da que está na lixeira). Veja o bloco "Fotos das atividades" abaixo e
//     docs/fotos-atividades.md.
//   - Segurança (seginter, seganom, seginsp, segfotos, config/seguranca) = perfil da Segurança (registra, trata, gestor, leitor)
//     e o supervisor da área (Operação · Supervisor numa área do conjunto da anomalia). Veja o bloco Segurança abaixo.
// Só vale o acesso por módulo: cadastro sem o campo acesso não tem acesso a nenhum módulo. Do cadastro antigo ficam
// só papel (qualquer perfil = ativo; 'bloqueado' = sem acesso nenhum) e 'gestao' em modulos (= com as Fichas).
// Áreas: area (líder e supervisor); area2 e a lista areas (só supervisor, quantas áreas precisar), conforme o perfil do módulo.
// A Bateria usa as mesmas coleções do Pátio com o prefixo b_.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function uref() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function hasProfile() { return signed() && exists(uref()); }
    function perfil() { return get(uref()).data; }
    function ativo() { return hasProfile() && perfil().papel in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'administrativo', 'leitor']; }
    // ---- Acesso por módulo ----
    function pmU(u, m) { return u.get('acesso', {}).get(m, ''); }                    // perfil no módulo ('' = sem acesso)
    function escU(u, e) { return e in u.get('escopos', []); }
    function adminU(u) { return u.papel != 'bloqueado' && pmU(u, 'administracao') == 'admin'; }
    function fichasU(u) { return 'gestao' in u.get('modulos', []); }                // Gestão com as Fichas de acompanhamento
    function pEm(m) { return pmU(perfil(), m); }
    function esc(e) { return escU(perfil(), e); }
    function admin() { return hasProfile() && adminU(perfil()); }
    // Área no perfil de um módulo: líder 1 área; supervisor também a 2ª e as da lista areas; gestor e coordenador todas.
    function supAreaU(u, area) { return u.get('area2', '') == area || area in u.get('areas', []); }
    function areaEm(p, area) { return p in ['gestor', 'coordenador'] || (p in ['supervisor', 'lider'] && (perfil().get('area', '') == area || (p == 'supervisor' && supAreaU(perfil(), area)))); }
    // Administração dos módulos: administrador; ou 'Dos módulos' sendo Gestor (Gestão) no escopo — Equipamentos aceita
    // também o Gestor da Operação; as Fichas pedem a Gestão com as Fichas.
    function admModNovo(m) {
      return pEm('administracao') == 'modulo' && (
        (m == 'operacao' && pEm('gestao') == 'gestor' && esc('patio'))
        || (m == 'bateria' && pEm('gestao') == 'gestor' && esc('bateria'))
        || (m == 'equipamentos' && (pEm('gestao') == 'gestor' || pEm('operacao') == 'gestor') && esc('equipamentos'))
        || (m == 'gestao' && pEm('gestao') == 'gestor' && fichasU(perfil())));
    }
    function admMod(m) { return admin() || (ativo() && admModNovo(m)); }   // administração do módulo
    // RH: Frequência e férias (ler) e quem grava (Administrativo).
    function acAdm() { return ativo() && (admin() || pEm('rh') != ''); }
    function admEdita() { return acAdm() && (admin() || pEm('rh') == 'administrativo'); }
    // Lê as Atividades de um conjunto (e = patio | bateria): Operação ou Gestão com o escopo.
    function lePB(e) { return ativo() && (admin() || ((pEm('operacao') != '' || pEm('gestao') != '') && esc(e))); }
    function op() { return lePB('patio'); }        // Atividades Pátio
    function ba() { return lePB('bateria'); }      // Atividades Bateria
    // Indicadores: lê os dados do escopo e (e = patio | bateria | equipamentos). Só aparece em regras de leitura.
    function indE(e) { return ativo() && pEm('indicadores') != '' && esc(e); }
    function indAlgum() { return indE('patio') || indE('bateria'); }
    function opI() { return op() || indE('patio'); }       // leitura do Pátio (Operação, Gestão ou Indicadores)
    function baI() { return ba() || indE('bateria'); }     // leitura da Bateria
    function eqmI() { return eqm() || indE('equipamentos'); }
    function ge() { return hasProfile() && geU(perfil()); }          // Fichas (Gestão)
    // Equipamentos: ler = escopo Equipamentos com Operação ou Gestão; gravar = Operação (líder a gestor).
    function eqm() { return ativo() && (admin() || ((pEm('operacao') != '' || pEm('gestao') != '') && esc('equipamentos'))); }
    function eqEdita() { return eqm() && (admin() || pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider']); }
    // Avaliação mensal (fica na Gestão): também quem lança pela Gestão.
    function eqAvalEdita() { return eqEdita() || (eqm() && pEm('gestao') in ['gestor', 'coordenador', 'supervisor', 'lider']); }
    function geEdita() { return hasProfile() && geEditaU(perfil()); }
    // Aponta e lança a presença na área (Operação · líder a gestor, com o escopo).
    function apontaDa(area, e) { return ativo() && esc(e) && pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider'] && areaEm(pEm('operacao'), area); }
    // Técnico de Processo (Operação): aprova e devolve em todas as áreas do escopo; não aponta. Ao devolver, a célula
    // volta a pendente na semana (só s e m mudam).
    function tecnicoEm(e) { return ativo() && esc(e) && pEm('operacao') == 'tecnico'; }
    function gestorDa(area) { return apontaDa(area, 'patio'); }
    function gestorDaB(area) { return apontaDa(area, 'bateria'); }
    // Atividade fora da programação (campo fp da semana): só coordenador e supervisor da área (e o administrador).
    function criaFora(area, e) { return apontaDa(area, e) && pEm('operacao') in ['coordenador', 'supervisor']; }
    function criaForaDa(area) { return criaFora(area, 'patio'); }
    function criaForaDaB(area) { return criaFora(area, 'bateria'); }
    // Presença do dia (situacao): quem aponta no conjunto (Operação), o RH (Administrativo) e o administrador.
    function lancaSit(e) { return admin() || admEdita() || (ativo() && esc(e) && pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider']); }
    // Efetivo por área: administrador, gestor, coordenador, administrativo e somente leitura veem todas as áreas;
    // supervisor, as 2 dele; líder, a dele; quem tem o escopo Equipamentos, também os operadores.
    function todasFichas() { return hasProfile() && todasFichasU(perfil()); }
    function minhaFicha(area) { return hasProfile() && minhaFichaU(perfil(), area); }
    // As mesmas contas, recebendo o perfil já lido (u): cada regra lê o perfil uma vez só e fica dentro do limite
    // de expressões do Firestore. Vale o perfil da Gestão e as Fichas (gestao em modulos).
    function pgU(u) { return adminU(u) ? 'admin' : pmU(u, 'gestao'); }   // perfil nas fichas
    function geU(u) { return u.papel in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'administrativo', 'leitor']
      && (adminU(u) || (pmU(u, 'gestao') != '' && fichasU(u))); }
    function geEditaU(u) { return geU(u) && pgU(u) in ['admin', 'gestor', 'coordenador', 'supervisor', 'lider', 'administrativo']; }
    function todasFichasU(u) { return geU(u) && pgU(u) in ['admin', 'gestor', 'coordenador', 'administrativo', 'leitor']; }
    function minhaAreaU(u, area) { return u.get('area', '') == area || (pgU(u) == 'supervisor' && supAreaU(u, area)); }
    function minhaFichaU(u, area) { return geU(u) && (minhaAreaU(u, area) || (area == 'OPERAÇÃO DE EQUIPAMENTOS' && escU(u, 'equipamentos'))); }
    function admGestaoU(u) { return adminU(u) || (pmU(u, 'administracao') == 'modulo' && pmU(u, 'gestao') == 'gestor' && fichasU(u)); }
    function veOcorrU(u, o) { return todasFichasU(u) || (geU(u) && (minhaFichaU(u, o.area) || o.criadoPor == request.auth.uid || o.recolhe == u.get('nomeUp', '#'))); }
    // Perfil no módulo (para Segurança e para os testes): null/'' = sem acesso.
    function perfilEm(mod) { return pEm(mod); }
    function temMod(mod) { return hasProfile() && perfil().papel != 'bloqueado' && pEm(mod) != ''; }
    function soAltera(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    // Quem gravou e quando: nas coleções principais (semanas, presença, cadastro das Atividades, fichas e ocorrências)
    // cada gravação do site traz atualizadoPor = quem está logado e atualizadoEm = hora do servidor. As rotinas do
    // GitHub usam a chave de serviço e não passam por aqui.
    function marcaOk() { return request.resource.data.get('atualizadoPor', '') == request.auth.uid && request.resource.data.get('atualizadoEm', null) == request.time; }

    // ---------- Formato dos dados (limites de campos e tamanhos) ----------
    // Cada gravação só passa com os campos no tipo e no tamanho esperados. ch = campos conferidos: na criação, todos
    // (novos()); na alteração, só os que mudaram (mudados()). Assim um registro antigo, de antes destes limites, continua
    // podendo ser alterado nos outros campos. Campo ausente ou vazio (null) sempre passa.
    function novos() { return request.resource.data.keys(); }
    function mudados() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function fTxt(d, ch, k, max) { return !(k in ch) || !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function fTxtNum(d, ch, k, max) { return fTxt(d, ch, k, max) || d[k] is number; }   // matrícula: texto ou número
    function fNum(d, ch, k, min, max) { return !(k in ch) || !(k in d) || d[k] == null || (d[k] is number && d[k] >= min && d[k] <= max); }
    function fMapa(d, ch, k, max) { return !(k in ch) || !(k in d) || (d[k] is map && d[k].size() <= max); }
    function fLista(d, ch, k, max) { return !(k in ch) || !(k in d) || (d[k] is list && d[k].size() <= max); }
    function fDia(d, ch, k) { return !(k in ch) || !(k in d) || d[k] == null || (d[k] is string && d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')); }
    function fHora(d, ch, k) { return !(k in ch) || !(k in d) || d[k] == null || (d[k] is string && d[k].matches('[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?')); }
    function fSim(d, ch, k) { return !(k in ch) || !(k in d) || d[k] == null || d[k] is bool; }
    // Campos de cima permitidos (só os que mudam; os que já existem no banco não atrapalham).
    function soCampos(ch, lista) { return ch.hasOnly(lista); }

    // Marca que o sistema já tem administrador (a tela de login lê para saber o que mostrar).
    // Ninguém grava pelo site: o administrador é criado ou recuperado pela rotina do GitHub
    // "Administrador do sistema", que usa a chave de serviço (não passa por estas regras).
    match /config/bootstrap {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Dados das planilhas originais para a importação (não ficam no repositório; entram no backup).
    // Gravados com a chave de serviço (integracao/admin/enviar-dados.mjs); só a administração do módulo correspondente lê.
    match /seeds/{nome} {
      allow get: if (nome == 'seed' && admMod('operacao'))
        || (nome == 'seed-bateria' && admMod('bateria'))
        || (nome == 'seed-equip' && admMod('equipamentos'))
        || (nome in ['seed-gestao', 'seed-efetivo'] && admMod('gestao'))
        || (nome in ['seed-freq-patio', 'seed-freq-bateria', 'seed-ferias'] && admin());
      allow list, create, update, delete: if false;
    }

    match /config/sistema {
      allow read: if opI();
      allow write: if admMod('operacao');
    }

    // Liga o usuário digitado na tela de login à conta interna. Leitura pública só de um item por vez.
    match /logins/{login} {
      allow get: if true;
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    // Só o administrador cadastra pessoas. A própria pessoa só grava trocarSenha e ultimoAcesso: papel, áreas, módulos,
    // abas e o acesso por módulo (acesso, escopos) ficam só com o administrador.
    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create: if admin();
      allow update: if admin()
        || (request.auth.uid == uid && soAltera(['trocarSenha', 'ultimoAcesso'])
            && request.resource.data.get('trocarSenha', false) == false);
      allow delete: if admin();
    }

    match /plano/{area} {
      allow read: if opI();
      allow write: if admMod('operacao');
    }

    // Cadastro das Atividades (colaboradores e b_colaboradores): { itens[], maiorId } + a marca de quem gravou.
    function colabsOk(ch) { let d = request.resource.data;
      return soCampos(ch, ['itens', 'maiorId', 'atualizadoPor', 'atualizadoEm']) && fLista(d, ch, 'itens', 2000) && fNum(d, ch, 'maiorId', 0, 100000); }
    // Presença do mês (situacao e b_situacao): v = código do dia; cob, he, hed, jus, ck = cobertura, horas extras,
    // justificativas e conferência. Cada um é um mapa 'PESSOA|AAAA-MM-DD' → valor (até 40 mil por mês).
    function sitOk(ch) { let d = request.resource.data;
      return soCampos(ch, ['v', 'cob', 'he', 'hed', 'jus', 'ck', 'mov', 'movK', 'trv', 'sitK', 'atualizadoPor', 'atualizadoEm'])
        && fMapa(d, ch, 'v', 40000) && fMapa(d, ch, 'cob', 40000) && fMapa(d, ch, 'he', 40000) && fMapa(d, ch, 'hed', 40000)
        && fMapa(d, ch, 'jus', 40000) && fMapa(d, ch, 'ck', 40000) && fMapa(d, ch, 'mov', 5000) && fMapa(d, ch, 'trv', 40000)
        && (!('sitK' in ch) || (d.sitK is string && d.sitK.size() <= 200)); }
    // Dia validado pelo RH travado no banco (trv; contas/efetivo-dia.js › travaEf). Ao validar, o RH grava em trv, junto
    // com o Efetivo do dia, a chave 'PESSOA|DATA' de cada pessoa da área e 'ck|DATA|ÁREA' (check-in), com a área; ao
    // reabrir, o administrador apaga essas chaves. Só o RH · Administrativo e o administrador mexem em trv e mudam um dia
    // travado. Quem lança pela Operação muda uma chave por gravação, dita em sitK (como movK), e ela não pode estar em trv.
    function sitAnt(f) { return resource == null ? {} : resource.data.get(f, {}); }
    function sitSo(ch, d, f, k) { return !(f in ch) || (d.get(f, {}) is map && d.get(f, {}).diff(sitAnt(f)).affectedKeys().hasOnly([k])); }
    function travaDe(k) { let p = k.split('[|]'); return p[0] == 'ck' && p.size() > 2 ? 'ck|' + p[1] + '|' + p[2] : k; }
    function sitLivre(ch, d) { let k = d.get('sitK', '');
      return !ch.hasAny(['v', 'cob', 'he', 'hed', 'jus', 'ck']) || (k is string && sitSo(ch, d, 'v', k) && sitSo(ch, d, 'cob', k)
        && sitSo(ch, d, 'he', k) && sitSo(ch, d, 'hed', k) && sitSo(ch, d, 'jus', k) && sitSo(ch, d, 'ck', k)
        && !(travaDe(k) in sitAnt('trv'))); }
    function sitTrava(ch) { return (!('trv' in ch) && sitLivre(ch, request.resource.data)) || admin() || admEdita(); }
    // Mover de rota no dia (mov; contas/mover-rota.js). Cada gravação muda uma chave só, dita em movK ('PESSOA|DATA').
    // Pedir (pendente): na mesma área, quem lança a presença da área; para outra área, do supervisor para cima da
    // área de origem. Aprovar (ou já gravar aprovado) e recusar: na mesma área, supervisor, coordenador ou gestor
    // da área; para outra área, só o administrador. Cancelar: quem pediu (pendente) ou quem aprova. Sem mudanças
    // depois que o RH valida o dia (efetivoDia da área de origem ou de destino).
    // Mesmas contas de apontaDa e admin, com o perfil já lido (u): fica dentro do limite de expressões do Firestore.
    function movArea(u, area) { let p = pmU(u, 'operacao'); return p in ['gestor', 'coordenador'] || u.get('area', '') == area || (p == 'supervisor' && supAreaU(u, area)); }
    function movAcima(u, area, e) { return escU(u, e) && pmU(u, 'operacao') in ['supervisor', 'coordenador', 'gestor'] && movArea(u, area); }
    function movPede(u, v, e) { return adminU(u) || (v.ao == v.ap ? escU(u, e) && pmU(u, 'operacao') in ['lider', 'supervisor', 'coordenador', 'gestor'] && movArea(u, v.ao) : movAcima(u, v.ao, e)); }
    function movAprova(u, v, e) { return adminU(u) || (v.ao == v.ap && movAcima(u, v.ap, e)); }
    function movValidado(c, id) { return exists(/databases/$(database)/documents/$(c)/$(id)) && get(/databases/$(database)/documents/$(c)/$(id)).data.get('st', '') == 'validado'; }
    function movLivre(v, e) { let c = e == 'bateria' ? 'b_efetivoDia' : 'efetivoDia';
      return !movValidado(c, v.dt + '_' + v.ao) && (v.ap == v.ao || !movValidado(c, v.dt + '_' + v.ap)); }
    function movForma(v, k) {
      return v is map && v.keys().hasOnly(['id', 'dt', 'de', 'para', 'ao', 'ap', 'st', 'por', 'nome', 'em', 'ok', 'okNome', 'okEm', 'mot'])
        && v.id is string && v.dt is string && v.dt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && k == v.id + '|' + v.dt
        && v.de is string && v.para is string && v.de.size() <= 120 && v.para.size() <= 120 && v.de != v.para
        && v.ao is string && v.ap is string && v.de.split('[|]')[0] == v.ao && v.para.split('[|]')[0] == v.ap
        && v.st in ['pendente', 'aprovado', 'recusado', 'cancelado'] && v.por is string && v.nome is string && v.nome.size() <= 80
        && v.get('mot', '') is string && v.get('mot', '').size() <= 200; }
    function movIgual(a, v) { return a != null && a.st == 'pendente' && a.de == v.de && a.para == v.para && a.por == v.por; }
    function movOk(e) { let d = request.resource.data; let k = d.get('movK', ''); let ant = resource == null ? {} : resource.data.get('mov', {});
      let v = d.mov.get(k, null); let a = ant.get(k, null); let me = request.auth.uid; let u = perfil();
      return d.mov.diff(ant).affectedKeys().hasOnly([k]) && movForma(v, k) && movRegra(u, e, v, a, me) && movLivre(v, e); }
    function movRegra(u, e, v, a, me) {
      return (v.st == 'pendente' && v.por == me && movPede(u, v, e) && (a == null || a.st != 'aprovado' || movAprova(u, a, e)))
          || (v.st == 'aprovado' && v.get('ok', '') == me && movAprova(u, v, e) && (v.por == me || movIgual(a, v)))
          || (v.st == 'recusado' && v.get('ok', '') == me && movAprova(u, v, e) && movIgual(a, v) && v.get('mot', '').size() > 0)
          || (v.st == 'cancelado' && a != null && a.st in ['pendente', 'aprovado'] && v.get('ok', '') == me
              && a.de == v.de && a.para == v.para && (movAprova(u, a, e) || (a.st == 'pendente' && a.por == me))); }
    function movSit(ch, e) { return !('mov' in ch) || movOk(e); }
    match /colaboradores/{area} {
      allow read: if opI() || acAdm();
      allow create: if (admMod('operacao') || admMod('gestao')) && marcaOk() && colabsOk(novos());
      allow update: if (admMod('operacao') || admMod('gestao')) && marcaOk() && colabsOk(mudados());
      allow delete: if admMod('operacao') || admMod('gestao');
    }

    // Presença do dia: a mesma para a Operação (Efetivo diário) e o Administrativo (Frequência).
    match /situacao/{mes} {
      allow read: if opI() || acAdm() || eqmI();   // Equipe e frota usa a mesma presença
      allow create: if lancaSit('patio') && marcaOk() && sitOk(novos()) && movSit(novos(), 'patio') && sitTrava(novos());
      allow update: if lancaSit('patio') && marcaOk() && sitOk(mudados()) && movSit(mudados(), 'patio') && sitTrava(mudados());
      allow delete: if admin() || admEdita();   // apagar o mês inteiro passaria por cima da trava
    }

    // Efetivo do dia (efetivoDia e b_efetivoDia/{AAAA-MM-DD}_{ÁREA}; contas/efetivo-dia.js): status do envio da presença
    // de cada área. Lê quem lê a presença. Enviar: quem aponta na área (líder e supervisor só nas áreas deles), enquanto
    // o dia não está validado. Validar e devolver (com motivo): o RH · Administrativo e o administrador, só o enviado.
    // Reabrir o validado: o RH · Administrativo e o administrador. Cada ação vai em nome de quem grava, com a hora do servidor.
    function efOk(id) { let d = request.resource.data;
      return d.keys().hasOnly(['area', 'data', 'mes', 'st', 'por', 'nome', 'em', 'mot', 'hist'])
        && d.area is string && d.data is string && d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.mes == d.data.split('-')[0] + '-' + d.data.split('-')[1] && id == d.data + '_' + d.area
        && d.por == request.auth.uid && d.em == request.time && d.nome is string && d.nome.size() <= 80
        && d.mot is string && d.mot.size() <= 300 && d.hist is list && d.hist.size() <= 60
        && d.st in ['enviado', 'validado', 'devolvido', 'aberto']
        && (d.st != 'devolvido' || d.mot.size() > 0); }
    function efPode(e) { let para = request.resource.data.st; let de = resource == null ? '' : resource.data.st;
      return (para == 'enviado' && de != 'validado' && (admin() || apontaDa(request.resource.data.area, e)))
        || (para in ['validado', 'devolvido'] && de == 'enviado' && admEdita())
        || (para == 'aberto' && de == 'validado' && admEdita()); }
    match /efetivoDia/{id} {
      allow read: if opI() || acAdm();
      allow create, update: if efOk(id) && efPode('patio');
      allow delete: if admin();
    }
    match /b_efetivoDia/{id} {
      allow read: if baI() || acAdm();
      allow create, update: if efOk(id) && efPode('bateria');
      allow delete: if admin();
    }

    // Apagar semanas e aprovações (Limpeza de dados) e o histórico: só o administrador. A dispensa das pendências
    // antigas (célula volta a '_' e a marca vai em dx) é uma alteração: o administrador já altera a semana inteira.
    // O mesmo vale para o feriado sem operação (célula volta a '_' e a marca vai em fe; public/feriados.js): grava o
    // administrador (Escalas e turnos) ou a rotina do GitHub (chave de serviço, que não passa por estas regras).
    // ft = quantas fotos cada célula tem (sobe no mesmo lote que grava a foto; veja Fotos das atividades abaixo).
    // qz = queda zero (opcional, material recolhido) de cada célula: grava quem aponta na área (contas/queda-zero.js).
    match /semanas/{id} {
      allow read: if opI();
      allow create: if admMod('operacao') && marcaOk();
      allow delete: if admin();
      allow update: if marcaOk() && (admMod('operacao') || (gestorDa(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'qz', 'atualizadoEm', 'atualizadoPor']))
        || (tecnicoEm('patio') && soAltera(['s', 'm', 'atualizadoEm', 'atualizadoPor']))
        || (criaForaDa(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'fp', 'qz', 'atualizadoEm', 'atualizadoPor'])));
    }

    // Aprovação dos apontamentos: o supervisor da área, o técnico de processo (todas as áreas do escopo) e o
    // administrador aprovam ou devolvem o que foi apontado.
    function aprova(area, e) { return (apontaDa(area, e) && pEm('operacao') == 'supervisor') || tecnicoEm(e) || admin(); }
    function aprovaDa(area) { return aprova(area, 'patio'); }
    // Plano de ação das causas: supervisor na área dele; coordenador, gestor e administrador também. Pela Operação
    // ou pela Gestão (a tela Causas e ações fica na Gestão).
    function acompanha(area, e) { return admin() || (ativo() && esc(e) && ((pEm('operacao') in ['gestor', 'coordenador', 'supervisor'] && areaEm(pEm('operacao'), area)) || (pEm('gestao') in ['gestor', 'coordenador', 'supervisor'] && areaEm(pEm('gestao'), area)))); }
    function acompanhaDa(area) { return acompanha(area, 'patio'); }
    match /aprov/{id} {
      allow read: if opI();
      allow create, update: if aprovaDa(request.resource.data.area) && (resource == null || resource.data.area == request.resource.data.area);
      allow delete: if admin();
    }

    // Plano de ação das causas de não realização: quem aprova na área (ou em todas, area 'TODAS') cria e acompanha.
    function acaoOk(d) { return d.area is string && d.causa is string && d.causa.size() <= 160 && d.acao is string && d.acao.size() <= 400; }
    function acaoTodas(e) { return admin() || (ativo() && esc(e) && (pEm('operacao') in ['gestor', 'coordenador'] || pEm('gestao') in ['gestor', 'coordenador'])); }
    function acaoPode(area, m) { return area == 'TODAS' ? acaoTodas(m == 'operacao' ? 'patio' : 'bateria') : (m == 'operacao' ? acompanhaDa(area) : acompanhaDaB(area)); }
    // Quem alterou a ação: atualizadoPor = quem está logado, com atualizadoEm novo (o site grava a hora do aparelho em texto).
    function acaoMarca() { return request.resource.data.get('atualizadoPor', '') == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['atualizadoEm']); }
    match /acoes/{id} {
      allow read: if opI();
      allow create: if acaoOk(request.resource.data) && request.resource.data.get('por', '') == request.auth.uid && acaoPode(request.resource.data.area, 'operacao');
      allow update: if acaoOk(request.resource.data) && acaoMarca() && resource.data.area == request.resource.data.area && acaoPode(resource.data.area, 'operacao');
      allow delete: if admMod('operacao');
    }
    match /b_acoes/{id} {
      allow read: if baI();
      allow create: if acaoOk(request.resource.data) && request.resource.data.get('por', '') == request.auth.uid && acaoPode(request.resource.data.area, 'bateria');
      allow update: if acaoOk(request.resource.data) && acaoMarca() && resource.data.area == request.resource.data.area && acaoPode(resource.data.area, 'bateria');
      allow delete: if admMod('bateria');
    }

    // ---------- Fotos das atividades (evidencias/evidenciasArquivo; Bateria com o prefixo b_) ----------
    // Um documento leve por foto (miniatura e dados da atividade; refs = as atividades que a foto comprova) e o arquivo
    // completo com o mesmo id, gravados no mesmo lote do apontamento (data.js › apontarComFotos). Modelo completo em
    // docs/fotos-atividades.md.
    // - Criar: quem aponta na área (a mesma regra do apontamento) ou o administrador, em nome próprio, com os campos
    //   obrigatórios (fase opcional: 'antes' ou 'depois', escolhida por quem tira a foto), miniatura até 40 mil caracteres e arquivo até 900 mil; a área tem de ser a da semana; o arquivo só
    //   entra junto do documento leve (getAfter), e os campos de exportação/lixeira/remoção nascem vazios.
    // - Ler: quem lê as semanas do conjunto (Operação ou Gestão com o escopo).
    // - Alterar: o autor só ajusta refs, até 24 h depois da foto e se ainda aponta na área; o administrador ajusta refs
    //   e os campos de exportação, lixeira e remoção (Parte 2). Nada mais muda.
    // - Parte 2 (Administração › Relatórios e arquivo de fotos), só o administrador:
    //   exportadoEm (hora) + exportLote (até 60 caracteres) + exportConf (conferência do SHA-256: ok, divergente,
    //   sem-sha) ao confirmar o .zip salvo; lixeiraEm (hora) só na foto já exportada (restaurar = lixeiraEm null);
    //   removidaEm (hora) só na foto que está na lixeira, no MESMO lote que apaga a foto completa (evidenciasArquivo).
    //   Depois de removida, a foto não volta: removidaEm, lixeiraEm e exportadoEm ficam como estão.
    // - Apagar o documento leve: o administrador; quem aponta na área (líder, supervisor, coordenador ou gestor da
    //   Operação; Apontar › fotos da atividade/do local) só a foto que ainda não foi exportada. Apagar a foto completa
    //   (evidenciasArquivo): o administrador junto da marca removidaEm numa foto exportada ou junto com o documento leve;
    //   quem aponta na área só junto com o documento leve.
    function fotoCampos() { return ['refs', 'semana', 'area', 'conj', 'pid', 'k', 'dia', 'mes', 'rota', 'sit', 'local', 'ativ', 'nome', 'tipo', 'tamanho',
      'bytes', 'w', 'h', 'sha', 'thumb', 'fase', 'por', 'porNome', 'at', 'exportadoEm', 'exportLote', 'exportConf', 'lixeiraEm', 'removidaEm']; }
    function fotoOk(d, col) {
      return d.keys().hasOnly(fotoCampos()) && d.keys().hasAll(['refs', 'semana', 'area', 'k', 'dia', 'mes', 'thumb', 'por', 'at', 'bytes', 'w', 'h', 'sha'])
        && d.por == request.auth.uid && d.at == request.time
        && d.refs is list && d.refs.size() >= 1 && d.refs.size() <= 100
        && d.semana is string && d.area is string && d.k is int && d.k >= 0 && d.k <= 6
        && d.dia is string && d.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.mes == d.dia.split('-')[0] + '-' + d.dia.split('-')[1]
        && d.thumb is string && d.thumb.size() <= 40000
        && d.bytes is int && d.bytes > 0 && d.bytes <= 700000 && d.w is int && d.h is int
        && d.sha is string && (d.sha == '' || d.sha.matches('[0-9a-f]{64}')) && d.get('fase', '') in ['', 'antes', 'depois']
        && d.get('ativ', '') is string && d.get('ativ', '').size() <= 600 && d.get('local', '') is string && d.get('local', '').size() <= 400
        && d.get('exportadoEm', null) == null && d.get('exportLote', null) == null && d.get('exportConf', null) == null && d.get('lixeiraEm', null) == null && d.get('removidaEm', null) == null
        && get(/databases/$(database)/documents/$(col)/$(d.semana)).data.area == d.area;
    }
    function arqOk(d, col, id) {
      let leve = getAfter(/databases/$(database)/documents/$(col)/$(id)).data;
      return d.keys().hasOnly(['area', 'semana', 'dia', 'sha', 'por', 'dados']) && d.por == request.auth.uid
        && d.dados is string && d.dados.size() <= 900000 && d.area is string
        && leve.por == request.auth.uid && leve.area == d.area;
    }
    function fotoAutor(e) {
      return resource.data.por == request.auth.uid && apontaDa(resource.data.area, e) && soAltera(['refs', 'atualizadoEm', 'atualizadoPor'])
        && request.time < resource.data.at + duration.value(24, 'h');
    }
    function fotoAdmin() {
      let d = request.resource.data;
      let antes = resource.data;
      return admin() && soAltera(['refs', 'exportadoEm', 'exportLote', 'exportConf', 'lixeiraEm', 'removidaEm', 'atualizadoEm', 'atualizadoPor'])
        && (d.get('exportadoEm', null) == null || d.get('exportadoEm', null) is timestamp)
        && (d.get('exportLote', null) == null || (d.get('exportLote', null) is string && d.get('exportLote', null).size() <= 60))
        && d.get('exportConf', null) in [null, 'ok', 'divergente', 'sem-sha']
        && (d.get('lixeiraEm', null) == null || (d.get('lixeiraEm', null) is timestamp && d.get('exportadoEm', null) != null))
        && (d.get('removidaEm', null) == null || (d.get('removidaEm', null) is timestamp && d.get('lixeiraEm', null) != null))
        && (antes.get('removidaEm', null) == null || (d.get('removidaEm', null) == antes.get('removidaEm', null)
          && d.get('lixeiraEm', null) == antes.get('lixeiraEm', null) && d.get('exportadoEm', null) == antes.get('exportadoEm', null)));
    }
    function refsOk(d) { return d.refs is list && d.refs.size() >= 1 && d.refs.size() <= 100; }
    // Foto do código antigo (só o campo ref, sem refs): o administrador marca exportação/lixeira sem criar refs.
    function refsOuAntiga(d) { return refsOk(d) || (!('refs' in d) && !('refs' in resource.data)); }
    // A foto completa só sai junto da marca removidaEm (foto exportada) ou junto com o documento leve.
    // Cada foto custa uma leitura (getAfter do leve): o lote de "apagar de vez" tem até 15 fotos, porque o Firestore
    // aceita no máximo 20 documentos lidos pelas regras num lote (fotos-arquivo.js › LOTE).
    function arqApagavel(col, id, e) {
      return (admin() && (!existsAfter(/databases/$(database)/documents/$(col)/$(id))
        || (getAfter(/databases/$(database)/documents/$(col)/$(id)).data.get('removidaEm', null) != null
          && getAfter(/databases/$(database)/documents/$(col)/$(id)).data.get('exportadoEm', null) != null)))
        || (apontaDa(resource.data.area, e) && !existsAfter(/databases/$(database)/documents/$(col)/$(id)));
    }
    // Quem aponta na área (Operação · líder, supervisor, coordenador ou gestor, na área e no escopo): apaga a foto ainda
    // não exportada (Apontar).
    function fotoApontaApaga(e) { return apontaDa(resource.data.area, e) && resource.data.get('exportadoEm', null) == null; }
    match /evidencias/{id} {
      allow read: if op();
      allow create: if (admin() || gestorDa(request.resource.data.area)) && fotoOk(request.resource.data, 'semanas');
      allow update: if (fotoAutor('patio') && refsOk(request.resource.data)) || (fotoAdmin() && refsOuAntiga(request.resource.data));
      allow delete: if admin() || fotoApontaApaga('patio');
    }
    match /evidenciasArquivo/{id} {
      allow read: if op();
      allow create: if (admin() || gestorDa(request.resource.data.area)) && arqOk(request.resource.data, 'evidencias', id);
      allow update: if false;
      allow delete: if arqApagavel('evidencias', id, 'patio');
    }
    // Configuração das fotos: todos os ativos leem; só o administrador grava (com os limites conferidos).
    match /config/fotos {
      allow read: if ativo();
      // max = Atividades; maxQZ = Queda zero; maxOM = OMs (opcionais, de 1 a 10).
      allow write: if admin() && request.resource.data.keys().hasOnly(['obrig', 'min', 'max', 'maxQZ', 'maxOM', 'situacoes', 'desde', 'atualizadoEm', 'por'])
        && (request.resource.data.get('maxQZ', 1) is int && request.resource.data.get('maxQZ', 1) >= 1 && request.resource.data.get('maxQZ', 1) <= 10)
        && (request.resource.data.get('maxOM', 1) is int && request.resource.data.get('maxOM', 1) >= 1 && request.resource.data.get('maxOM', 1) <= 10)
        && request.resource.data.obrig is bool && request.resource.data.min is int && request.resource.data.max is int
        && request.resource.data.min >= 0 && (request.resource.data.obrig == false || request.resource.data.min >= 1) && request.resource.data.max >= request.resource.data.min
        && request.resource.data.max >= 1 && request.resource.data.max <= 10
        && request.resource.data.situacoes is list && request.resource.data.situacoes.hasOnly(['R', 'E', 'N'])
        && (!request.resource.data.obrig || request.resource.data.situacoes.size() >= 1);
    }

    // Queda zero: locais e motivos cadastrados pelo pessoal (as listas padrão ficam no código). Todos leem; quem aponta
    // (líder para cima) ou o administrador acrescenta.
    match /config/quedazero {
      allow read: if ativo();
      allow create, update: if (admin() || (ativo() && pEm('operacao') in ['gestor', 'coordenador', 'supervisor', 'lider']))
        && request.resource.data.keys().hasOnly(['locais', 'motivos', 'atualizadoEm', 'por'])
        && request.resource.data.get('locais', []) is list && request.resource.data.get('locais', []).size() <= 500
        && request.resource.data.get('motivos', []) is list && request.resource.data.get('motivos', []).size() <= 200;
    }

    // Gestão › Medição (medicao/{AAAA-MM}): l = lançados, oc = ocultos, man = registros digitados (contas/medicao.js).
    // Lê: administrador e Gestão (Gestor, Coordenador, Administrativo). Grava: administrador, Gestor e Coordenador da
    // Gestão, sempre em nome de quem grava e com a hora do servidor (marcaOk). Só estes campos, mapas com limite.
    function medLe() { return ativo() && (admin() || pEm('gestao') in ['gestor', 'coordenador', 'administrativo']); }
    function medEdita() { return ativo() && (admin() || pEm('gestao') in ['gestor', 'coordenador']); }
    match /medicao/{mes} {
      allow read: if medLe();
      allow create, update: if medEdita() && mes.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$') && marcaOk()
        && request.resource.data.keys().hasOnly(['l', 'oc', 'man', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.get('l', {}) is map && request.resource.data.get('l', {}).size() <= 5000
        && request.resource.data.get('oc', {}) is map && request.resource.data.get('oc', {}).size() <= 5000
        && request.resource.data.get('man', {}) is map && request.resource.data.get('man', {}).size() <= 1500;
      allow delete: if admin();
    }

    // Gestão › Tratativas (tratativas/{id}: tipo acao | plano | ata; contas/tratativas.js). Lê: quem tem a Gestão.
    // Cria e altera: administrador e Gestão (Gestor, Coordenador, Supervisor), sempre em nome de quem grava e com a hora
    // do servidor (marcaOk), sem trocar o tipo nem quem criou. Apaga: administrador, Gestor da Gestão ou quem criou.
    function tratLe() { return ativo() && (admin() || pEm('gestao') != ''); }
    function tratEdita() { return ativo() && (admin() || pEm('gestao') in ['gestor', 'coordenador', 'supervisor']); }
    function tTxt(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function tratAcaoOk(d) {
      return d.keys().hasOnly(['tipo', 'titulo', 'por', 'origem', 'ref', 'conj', 'local', 'inicio', 'prazo', 'resp', 'como', 'custo', 'custoReal', 'status', 'plano', 'causa', 'area', 'ata', 'evol', 'feitaEm', 'criadoEm', 'criadoPor', 'criadoNome', 'atualizadoEm', 'atualizadoPor'])
        && d.titulo is string && d.titulo.size() >= 5 && d.titulo.size() <= 400
        && d.status in ['aberta', 'andamento', 'feita', 'cancelada']
        && d.origem in ['atividades', 'equipamentos', 'efetivo', 'queda', 'seguranca', 'reuniao', 'processos', 'cliente', 'outra']
        && tTxt(d, 'por', 2000) && tTxt(d, 'como', 2000) && tTxt(d, 'resp', 120) && tTxt(d, 'local', 120) && tTxt(d, 'ref', 120)
        && d.get('evol', []) is list && d.get('evol', []).size() <= 200;
    }
    function tratPlanoOk(d) {
      return d.keys().hasOnly(['tipo', 'nome', 'objetivo', 'conj', 'status', 'criadoEm', 'criadoPor', 'criadoNome', 'atualizadoEm', 'atualizadoPor'])
        && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 120 && d.status in ['ativo', 'concluido'] && tTxt(d, 'objetivo', 2000);
    }
    function tratAtaOk(d) {
      return d.keys().hasOnly(['tipo', 'titulo', 'data', 'local', 'participantes', 'pauta', 'decisoes', 'enc', 'plano', 'criadoEm', 'criadoPor', 'criadoNome', 'atualizadoEm', 'atualizadoPor'])
        && d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 300 && d.data is string && d.data.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && tTxt(d, 'pauta', 5000) && tTxt(d, 'decisoes', 5000) && tTxt(d, 'participantes', 600)
        && d.get('enc', []) is list && d.get('enc', []).size() <= 60;
    }
    function tratDocOk(d) { return (d.tipo == 'acao' && tratAcaoOk(d)) || (d.tipo == 'plano' && tratPlanoOk(d)) || (d.tipo == 'ata' && tratAtaOk(d)); }
    match /tratativas/{id} {
      allow read: if tratLe();
      allow create: if tratEdita() && tratDocOk(request.resource.data) && request.resource.data.get('criadoPor', '') == request.auth.uid && marcaOk();
      allow update: if tratEdita() && tratDocOk(request.resource.data) && marcaOk() && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.get('criadoPor', '') == resource.data.get('criadoPor', '');
      allow delete: if admin() || (tratEdita() && (pEm('gestao') == 'gestor' || resource.data.get('criadoPor', '') == request.auth.uid));
    }

    // Administração › Processos e rotina (contas/processos.js): só o administrador lê e grava, sempre com a marca de quem
    // gravou. processos/config = os processos (itens, até 30) e desde quando a rotina conta; rotina/{pid}_{data} = o que
    // foi marcado em cada tarefa (situação, passos e observação).
    match /processos/config {
      allow read: if admin();
      allow create, update: if admin() && marcaOk()
        && request.resource.data.keys().hasOnly(['itens', 'desde', 'dono', 'donoNome', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.get('itens', {}) is map && request.resource.data.get('itens', {}).size() <= 30
        && tTxt(request.resource.data, 'desde', 10) && tTxt(request.resource.data, 'dono', 128) && tTxt(request.resource.data, 'donoNome', 150);
      allow delete: if admin();
    }
    match /rotina/{id} {
      allow read: if admin();
      allow create, update: if admin() && marcaOk()
        && request.resource.data.keys().hasOnly(['pid', 'data', 'status', 'passos', 'obs', 'feitaEm', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.pid is string && request.resource.data.pid.matches('^P[0-9]{2}$')
        && request.resource.data.data is string && request.resource.data.data.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && id == request.resource.data.pid + '_' + request.resource.data.data
        && request.resource.data.status in ['aberta', 'andamento', 'feita', 'nfeita']
        && request.resource.data.get('passos', []) is list && request.resource.data.get('passos', []).size() <= 20
        && tTxt(request.resource.data, 'obs', 600) && tTxt(request.resource.data, 'feitaEm', 40);
      allow delete: if admin();
    }

    // Operação › Solicitações de OM (contas/oms.js): quem tem a Operação no conjunto lê. Abre: líder e supervisor (nas
    // áreas deles), coordenador, gestor e administrador. Trata (aprova, devolve, envia ao cliente, libera, cancela): Técnico de
    // Processo, coordenador e gestor da Operação no conjunto, e o administrador. Quem abriu corrige ou cancela enquanto está
    // planejada, com o técnico ou devolvida; o líder da área finaliza a OM liberada. Conjunto e quem abriu não mudam.
    // OM planejada (com a data prevista dPrev): cadastrada por quem abre ou por quem trata; no dia, quem cadastrou, quem trata
    // ou o líder da área a transforma em solicitação (só a situação, a hora e o histórico).
    // Documentação (docs: PT, APR, bloqueio, isolamento, acompanhamento; cada uma pend/ok/na, não obrigatória): quem trata e
    // o líder da área marcam enquanto a OM está aberta. Cliente (clienteUid, quem recebeu a OM): com a OM enviada, toca em
    // Ciente (só a hora e o nome) e em Liberar (vira liberada, marcada libCli), Recusar (vira recusada) ou Cancelar (também
    // com a OM já liberada); recusa e cancelamento pelo cliente levam o motivo, a hora (hCanc) e cancCli. Observações de cada
    // passo ficam no histórico (hist), que não é conferido linha a linha.
    // Processo do bloqueio (2026-11-19): o "Ciente" virou "OM gerada" (hCiente, com o número da OM); ao liberar, o cliente
    // grava também as horas que a sala de controle passou (hSala: passou ao eletricista; hEletr: eletricista liberou). O líder
    // da área grava a hora do desbloqueio pela sala (hDesb) ao finalizar ou depois, com a OM já finalizada.
    // 2026-11-24: o cliente só passa a Liberada com a OM já gerada (hCiente) e com a hora em que o eletricista liberou (hEletr).
    function omTrata(e) { return admin() || (ativo() && esc(e) && pEm('operacao') in ['tecnico', 'coordenador', 'gestor']); }
    function omAbre(e, area) { return admin() || (ativo() && esc(e) && pEm('operacao') in ['lider', 'supervisor', 'coordenador', 'gestor'] && areaEm(pEm('operacao'), area)); }
    // Campos da OM. Na criação, confere todos; na alteração, só os que mudam (bem mais barato: a regra das OMs está perto do
    // limite de 1000 expressões do Firestore).
    function omCampos() { return ['conj', 'area', 'local', 'equip', 'titulo', 'desc', 'tipo', 'prio', 'status', 'numero', 'motivo', 'obsFim', 'hSol', 'dPrev', 'hAprov', 'hEnvio', 'hLib', 'hFim', 'aprovPor', 'aprovNome', 'solPor', 'solNome', 'cliente', 'clienteUid', 'contato', 'hist', 'criadoEm', 'atualizadoEm', 'atualizadoPor', 'docs', 'hCiente', 'cienteNome', 'libNome', 'libCli', 'hCanc', 'cancNome', 'cancCli', 'hSala', 'hEletr', 'hDesb']; }
    // Na criação, só os campos de quem abre ou planeja (os da parte 2 e 3 nascem depois, nos passos seguintes).
    function omCamposNovo() { return ['conj', 'area', 'local', 'equip', 'titulo', 'desc', 'tipo', 'prio', 'status', 'hSol', 'dPrev', 'solPor', 'solNome', 'hist', 'criadoEm', 'atualizadoEm', 'atualizadoPor', 'docs']; }
    function omOk(d) {
      return d.conj in ['patio', 'bateria'] && d.status in ['planejada', 'solicitada', 'devolvida', 'aprovada', 'enviada', 'recusada', 'liberada', 'finalizada', 'cancelada']
        && d.titulo is string && d.titulo.size() >= 5 && d.titulo.size() <= 200 && d.area is string && d.area.size() <= 40
        && d.get('tipo', 'corretiva') in ['corretiva', 'preventiva', 'melhoria', 'seguranca'] && d.get('prio', 'media') in ['baixa', 'media', 'alta', 'emergencia']
        && d.get('hist', []) is list && d.get('hist', []).size() <= 60;
    }
    // Tamanho dos textos: na criação e nos caminhos que mudam qualquer campo (quem trata, quem abriu). Os caminhos estreitos
    // (finalizar, documentação/observação, cliente) conferem só os campos que podem mudar: a regra das OMs está no limite
    // de 1000 expressões do Firestore.
    function omTxtOk(d) {
      return tTxt(d, 'local', 120) && tTxt(d, 'equip', 80) && tTxt(d, 'desc', 1000) && tTxt(d, 'numero', 40) && tTxt(d, 'motivo', 400) && tTxt(d, 'obsFim', 600)
        && tTxt(d, 'hSol', 16) && tTxt(d, 'dPrev', 10) && tTxt(d, 'hAprov', 16) && tTxt(d, 'hEnvio', 16) && tTxt(d, 'hLib', 16) && tTxt(d, 'hFim', 16)
        && tTxt(d, 'solNome', 150) && tTxt(d, 'aprovNome', 150) && tTxt(d, 'criadoEm', 40) && tTxt(d, 'cliente', 120) && tTxt(d, 'clienteUid', 128) && tTxt(d, 'contato', 120);
    }
    // Campos da parte 2 (documentação, ciente, quem liberou): conferidos só quando mudam, para a regra não passar do
    // limite de 1000 expressões do Firestore.
    function omExtraOk(d) {
      return tTxt(d, 'hCiente', 16) && tTxt(d, 'cienteNome', 150) && tTxt(d, 'libNome', 150) && d.get('libCli', false) is bool
        && tTxt(d, 'hCanc', 16) && tTxt(d, 'cancNome', 150) && d.get('cancCli', false) is bool && omDocsOk(d.get('docs', {}))
        && tTxt(d, 'hSala', 16) && tTxt(d, 'hEletr', 16) && tTxt(d, 'hDesb', 16);
    }
    // Quem abriu, ao corrigir ou cancelar: só os campos do formulário, a documentação e o cancelamento (nunca em nome do
    // cliente); ciente, liberação e envio ficam como estão.
    function omSoDocs() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['area', 'local', 'equip', 'titulo', 'desc', 'tipo', 'prio', 'status', 'hSol', 'dPrev', 'motivo', 'docs', 'hist', 'hCanc', 'cancNome', 'cancCli', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.get('cancCli', false) == false && omDocsOk(request.resource.data.get('docs', {}))
        && tTxt(request.resource.data, 'local', 120) && tTxt(request.resource.data, 'equip', 80) && tTxt(request.resource.data, 'desc', 1000)
        && tTxt(request.resource.data, 'motivo', 400) && tTxt(request.resource.data, 'hSol', 16) && tTxt(request.resource.data, 'dPrev', 10);
    }
    function omDocsOk(m) { return m is map && m.keys().hasOnly(['pt', 'apr', 'bloq', 'isol', 'acomp']) && m.values().hasOnly(['pend', 'ok', 'na']); }
    // Prazo de resposta do cliente por prioridade, em horas inteiras de 0 (sem prazo) a 720.
    function omPzV(m, k) { return !(k in m) || (m[k] is int && m[k] >= 0 && m[k] <= 720); }
    function omPrazosOk(m) {
      return m is map && m.keys().hasOnly(['emergencia', 'alta', 'media', 'baixa'])
        && omPzV(m, 'emergencia') && omPzV(m, 'alta') && omPzV(m, 'media') && omPzV(m, 'baixa');
    }
    // Cliente de cada conjunto (usuário do sistema que recebe as OMs enviadas) e prazos de resposta: quem está ativo lê,
    // o administrador escolhe.
    match /config/oms {
      allow read: if ativo();
      allow write: if admin() && request.resource.data.keys().hasOnly(['clientes', 'prazos', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.get('clientes', {}) is map && request.resource.data.get('clientes', {}).keys().hasOnly(['patio', 'bateria'])
        && omPrazosOk(request.resource.data.get('prazos', {}));
    }
    match /oms/{id} {
      allow read: if admin() || (ativo() && pEm('operacao') != '' && esc(resource.data.conj)) || indE(resource.data.conj);   // Indicadores › OMs: só leitura no escopo
      // Começa pelo barato (documento novo, situação e autor): a gravação com merge confere a criação e a alteração na mesma
      // conta de 1000 expressões.
      allow create: if resource == null && request.resource.data.status in ['solicitada', 'planejada'] && request.resource.data.solPor == request.auth.uid && marcaOk()
        && request.resource.data.keys().hasOnly(omCamposNovo()) && omOk(request.resource.data) && omTxtOk(request.resource.data) && omDocsOk(request.resource.data.get('docs', {}))
        && ((request.resource.data.status == 'solicitada' && omAbre(request.resource.data.conj, request.resource.data.area))
          || (request.resource.data.status == 'planejada' && (omAbre(request.resource.data.conj, request.resource.data.area) || omTrata(request.resource.data.conj))));
      // As duas primeiras opções (documentação e cliente) vêm antes e começam pelo que é barato de conferir: a regra das OMs
      // está perto do limite de 1000 expressões do Firestore.
      // Os campos da parte 2 (documentação, ciente, quem liberou) são conferidos só no caminho que os grava: a regra das OMs
      // está perto do limite de 1000 expressões do Firestore.
      allow update: if marcaOk() && request.resource.data.keys().hasOnly(omCampos()) && omOk(request.resource.data)
        && request.resource.data.conj == resource.data.conj && request.resource.data.solPor == resource.data.solPor
        && ((omTrata(resource.data.conj) && omTxtOk(request.resource.data) && omExtraOk(request.resource.data))
          || (resource.data.get('clienteUid', '') == request.auth.uid && resource.data.status in ['enviada', 'liberada'] && ativo() && omExtraOk(request.resource.data)
              && tTxt(request.resource.data, 'motivo', 400) && tTxt(request.resource.data, 'hLib', 16) && tTxt(request.resource.data, 'numero', 40)
              && ((request.resource.data.status == resource.data.status
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hCiente', 'cienteNome', 'numero', 'hist', 'atualizadoEm', 'atualizadoPor']))
                || (resource.data.status == 'enviada' && request.resource.data.status == 'liberada' && request.resource.data.get('libCli', false) == true
                    && resource.data.get('hCiente', '') != '' && request.resource.data.get('hEletr', '') != ''
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hLib', 'numero', 'hCiente', 'cienteNome', 'libNome', 'libCli', 'hSala', 'hEletr', 'hist', 'atualizadoEm', 'atualizadoPor']))
                || (((resource.data.status == 'enviada' && request.resource.data.status == 'recusada') || request.resource.data.status == 'cancelada')
                    && request.resource.data.get('cancCli', false) == true && request.resource.data.get('motivo', '').size() >= 5
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'motivo', 'hCanc', 'cancNome', 'cancCli', 'hist', 'atualizadoEm', 'atualizadoPor']))))
          || (resource.data.solPor == request.auth.uid && ativo() && resource.data.status in ['planejada', 'solicitada', 'devolvida']
              && (request.resource.data.status in ['solicitada', 'cancelada'] || (resource.data.status == 'planejada' && request.resource.data.status == 'planejada'))
              && omAbre(resource.data.conj, request.resource.data.area) && omSoDocs())
          || (resource.data.status == 'planejada' && request.resource.data.status == 'solicitada' && omAbre(resource.data.conj, resource.data.area)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hSol', 'hist', 'atualizadoEm', 'atualizadoPor']) && tTxt(request.resource.data, 'hSol', 16))
          || (resource.data.status == 'liberada' && request.resource.data.status == 'finalizada' && omAbre(resource.data.conj, resource.data.area)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hFim', 'obsFim', 'hDesb', 'hist', 'atualizadoEm', 'atualizadoPor'])
              && tTxt(request.resource.data, 'hFim', 16) && tTxt(request.resource.data, 'obsFim', 600) && tTxt(request.resource.data, 'hDesb', 16))
          || (resource.data.status == 'finalizada' && request.resource.data.status == 'finalizada' && resource.data.get('hDesb', '') == '' && omAbre(resource.data.conj, resource.data.area)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hDesb', 'hist', 'atualizadoEm', 'atualizadoPor']) && tTxt(request.resource.data, 'hDesb', 16))
          || (request.resource.data.status == resource.data.status && resource.data.status in ['planejada', 'solicitada', 'devolvida', 'aprovada', 'enviada', 'recusada', 'liberada']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['docs', 'hist', 'atualizadoEm', 'atualizadoPor']) && omAbre(resource.data.conj, resource.data.area)
              && omDocsOk(request.resource.data.get('docs', {}))));
      allow delete: if omTrata(resource.data.conj);
    }
    // Preventivas que se repetem (contas/oms-recorrentes.js): quem trata as OMs no conjunto cadastra, muda e apaga; quem lê
    // as OMs lê. As OMs planejadas de cada data são criadas pela tela com as regras de oms/{id} (status planejada).
    match /omsrec/{id} {
      allow read: if admin() || (ativo() && pEm('operacao') != '' && esc(resource.data.conj));
      allow create, update: if marcaOk() && omTrata(request.resource.data.conj) && (resource == null || resource.data.conj == request.resource.data.conj)
        && request.resource.data.keys().hasOnly(['conj', 'area', 'local', 'equip', 'titulo', 'desc', 'prio', 'freq', 'dias', 'dia', 'inicio', 'ativa', 'ate', 'criadoPor', 'criadoNome', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.conj in ['patio', 'bateria'] && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 5 && request.resource.data.titulo.size() <= 200
        && request.resource.data.area is string && request.resource.data.area.size() <= 40 && tTxt(request.resource.data, 'local', 120) && tTxt(request.resource.data, 'equip', 80)
        && tTxt(request.resource.data, 'desc', 1000) && request.resource.data.get('prio', 'media') in ['baixa', 'media', 'alta', 'emergencia']
        && request.resource.data.freq in ['semana', 'quinzena', 'mes'] && request.resource.data.get('dias', []) is list && request.resource.data.get('dias', []).size() <= 7
        && request.resource.data.get('dia', 0) is int && request.resource.data.get('ativa', true) is bool
        && tTxt(request.resource.data, 'inicio', 10) && tTxt(request.resource.data, 'ate', 10) && tTxt(request.resource.data, 'criadoNome', 150) && tTxt(request.resource.data, 'criadoPor', 128);
      allow delete: if omTrata(resource.data.conj);
    }

    // A coleção antiga documentos (Administração › Documentos e OMs, que saiu em 17/11/2026) não tem regra: ninguém lê
    // nem grava pelo sistema (conferida em 22/11/2026: já estava vazia no banco).

    // Indicadores do contrato (Indicadores › Visão geral e Histórico): metas, ICCC/ICCP do mês e o histórico dos meses.
    // Quem tem o módulo Indicadores lê; o Gestor dos Indicadores e o administrador gravam (só estes campos, mapas pequenos).
    match /config/indicadores {
      allow read: if admin() || (ativo() && pEm('indicadores') != '');
      allow create, update: if (admin() || (ativo() && pEm('indicadores') == 'gestor'))
        && request.resource.data.keys().hasOnly(['metas', 'valores', 'hist', 'atualizadoEm', 'por'])
        && request.resource.data.get('metas', {}) is map && request.resource.data.get('metas', {}).keys().hasOnly(['abs', 'he', 'hp', 'iccc', 'iccp', 'efic', 'queda', 's5'])
        && request.resource.data.get('valores', {}) is map && request.resource.data.get('valores', {}).size() <= 240
        && request.resource.data.get('hist', {}) is map && request.resource.data.get('hist', {}).size() <= 480
        && request.resource.data.get('por', '') is string && request.resource.data.get('por', '').size() <= 150;
      allow delete: if admin();
    }

    // ---------- Módulo Atividades Bateria (mesma estrutura do Pátio, prefixo b_) ----------
    match /b_config/sistema {
      allow read: if baI();
      allow write: if admMod('bateria');
    }
    match /b_plano/{area} {
      allow read: if baI();
      allow write: if admMod('bateria');
    }
    match /b_colaboradores/{area} {
      allow read: if baI() || acAdm();
      allow create: if (admMod('bateria') || admMod('gestao')) && marcaOk() && colabsOk(novos());
      allow update: if (admMod('bateria') || admMod('gestao')) && marcaOk() && colabsOk(mudados());
      allow delete: if admMod('bateria') || admMod('gestao');
    }
    match /b_situacao/{mes} {
      allow read: if baI() || acAdm() || eqmI();
      allow create: if lancaSit('bateria') && marcaOk() && sitOk(novos()) && movSit(novos(), 'bateria') && sitTrava(novos());
      allow update: if lancaSit('bateria') && marcaOk() && sitOk(mudados()) && movSit(mudados(), 'bateria') && sitTrava(mudados());
      allow delete: if admin() || admEdita();   // apagar o mês inteiro passaria por cima da trava
    }
    match /b_semanas/{id} {
      allow read: if baI();
      allow create: if admMod('bateria') && marcaOk();
      allow delete: if admin();
      allow update: if marcaOk() && (admMod('bateria') || (gestorDaB(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'qz', 'atualizadoEm', 'atualizadoPor']))
        || (tecnicoEm('bateria') && soAltera(['s', 'm', 'atualizadoEm', 'atualizadoPor']))
        || (criaForaDaB(resource.data.area) && soAltera(['s', 'm', 'ev', 'ft', 'fp', 'qz', 'atualizadoEm', 'atualizadoPor'])));
    }
    function aprovaDaB(area) { return aprova(area, 'bateria'); }
    function acompanhaDaB(area) { return acompanha(area, 'bateria'); }
    match /b_aprov/{id} {
      allow read: if baI();
      allow create, update: if aprovaDaB(request.resource.data.area) && (resource == null || resource.data.area == request.resource.data.area);
      allow delete: if admin();
    }
    match /b_evidencias/{id} {
      allow read: if ba();
      allow create: if (admin() || gestorDaB(request.resource.data.area)) && fotoOk(request.resource.data, 'b_semanas');
      allow update: if (fotoAutor('bateria') && refsOk(request.resource.data)) || (fotoAdmin() && refsOuAntiga(request.resource.data));
      allow delete: if admin() || fotoApontaApaga('bateria');
    }
    match /b_evidenciasArquivo/{id} {
      allow read: if ba();
      allow create: if (admin() || gestorDaB(request.resource.data.area)) && arqOk(request.resource.data, 'b_evidencias', id);
      allow update: if false;
      allow delete: if arqApagavel('b_evidencias', id, 'bateria');
    }

    // ---------- Módulo Operação: controle de equipamentos ----------
    // eq/cadastro = { operadores[], frota[] }; eq/config = turnos, causas, metas, pesos, feriados (administração).
    function eqCadOk(ch) { let d = request.resource.data; return fLista(d, ch, 'operadores', 2000) && fLista(d, ch, 'frota', 1000); }
    match /eq/{docId} {
      allow read: if eqmI();
      allow create: if (admMod('equipamentos') || (docId == 'cadastro' && (eqEdita() || admMod('gestao')))) && eqCadOk(novos());
      allow update: if (admMod('equipamentos') || (docId == 'cadastro' && (eqEdita() || admMod('gestao')))) && eqCadOk(mudados());
      allow delete: if admMod('equipamentos');
    }
    // Lançamentos, paradas e inspeções (S5): cada registro guarda quem lançou (por) e quando (em, hora do servidor), que
    // não mudam depois. Alterar e apagar: o autor, o supervisor para cima (Operação · Gestor, Coordenador ou Supervisor) e
    // o administrador. Os outros líderes só fazem o que a operação do dia pede no registro de outra pessoa: mudar o
    // status e fechar o horário/troca do lançamento (status, fim, trocaPara) e liberar ou substituir a parada (fim,
    // subst, lancSub). Inspeção de outra pessoa: o líder não altera nem apaga.
    function eqSup() { return eqm() && (admin() || pEm('operacao') in ['gestor', 'coordenador', 'supervisor']); }
    function eqAutor() { return resource.data.get('por', '') == request.auth.uid; }
    function eqDataOk(d, ch) { return !ch.hasAny(['data', 'mes']) || dataOk(d); }
    function eqCria() { let d = request.resource.data;
      return eqEdita() && d.get('por', '') == request.auth.uid && d.get('em', null) == request.time && dataOk(d) && d.keys().size() <= 40; }
    function eqAltera(livres) { let ch = mudados();
      return eqEdita() && !ch.hasAny(['por', 'em']) && eqDataOk(request.resource.data, ch) && request.resource.data.keys().size() <= 40
        && (eqSup() || eqAutor() || ch.hasOnly(livres)); }
    function eqApaga() { return eqEdita() && (eqSup() || eqAutor()); }
    function lancOk(ch) { let d = request.resource.data;
      return fTxt(d, ch, 'eq', 30) && fTxt(d, ch, 'tipo', 60) && fTxt(d, ch, 'op', 120) && fTxt(d, ch, 'area', 80) && fTxt(d, ch, 'setor', 80)
        && fTxt(d, ch, 'status', 40) && fHora(d, ch, 'ini') && fHora(d, ch, 'fim') && fNum(d, ch, 'he', 0, 24) && fTxt(d, ch, 'heOrigem', 10)
        && fTxt(d, ch, 'sub', 120) && fTxt(d, ch, 'obs', 500) && fTxt(d, ch, 'trocaPara', 30) && fTxt(d, ch, 'voltaDe', 30); }
    function parOk(ch) { let d = request.resource.data;
      return fTxt(d, ch, 'eq', 30) && fTxt(d, ch, 'op', 120) && fHora(d, ch, 'ini') && fHora(d, ch, 'fim') && fTxt(d, ch, 'causa', 120)
        && fTxt(d, ch, 'desc', 500) && fTxt(d, ch, 'os', 40) && fTxt(d, ch, 'subst', 30) && fTxt(d, ch, 'lancSub', 40); }
    function inspOk(ch) { let d = request.resource.data;
      return fTxt(d, ch, 'eq', 30) && fTxt(d, ch, 'op', 120) && fMapa(d, ch, 'itens', 60) && fNum(d, ch, 'p5s', 0, 100) && fNum(d, ch, 'pseg', 0, 100)
        && fTxt(d, ch, 'inspetor', 120) && fTxt(d, ch, 'obs', 500); }
    // Lançamentos: quem tem a Frequência também lê, porque a hora extra da Operação entra na folha.
    // Os aparelhos só recebem o que mudou (nucleo/incremental.js): toda gravação leva atualizadoEm (hora do servidor) e
    // excluir no sistema vira apagado: true, só para quem pode apagar (apagado não está nos campos livres dos líderes).
    function lancMarca() { let d = request.resource.data; return d.get('atualizadoEm', null) == request.time && d.get('apagado', false) is bool; }
    match /eqlanc/{id} {
      allow read: if eqmI() || acAdm();
      allow create: if eqCria() && lancMarca() && request.resource.data.get('eq', '') is string && request.resource.data.get('eq', '').size() > 0 && lancOk(novos());
      allow update: if eqAltera(['status', 'fim', 'trocaPara', 'atualizadoEm']) && lancMarca() && lancOk(mudados());
      allow delete: if eqApaga();
    }
    match /eqpar/{id} {
      allow read: if eqmI();
      allow create: if eqCria() && request.resource.data.get('eq', '') is string && request.resource.data.get('eq', '').size() > 0 && parOk(novos());
      allow update: if eqAltera(['fim', 'subst', 'lancSub']) && parOk(mudados());
      allow delete: if eqApaga();
    }
    match /eqinsp/{id} {
      allow read: if eqmI();
      allow create: if eqCria() && inspOk(novos());
      allow update: if eqAltera([]) && inspOk(mudados());
      allow delete: if eqApaga();
    }
    // Avaliação mensal: { itens: { OPERADOR: {proat, s5, seg, faltas, atrasos, atest, obs} } }.
    function avalOk(ch) { return soCampos(ch, ['itens']) && fMapa(request.resource.data, ch, 'itens', 2000); }
    match /eqaval/{mes} {
      allow read: if eqmI();
      allow create: if eqAvalEdita() && mes.matches('[0-9]{4}-[0-9]{2}') && avalOk(novos());
      allow update: if eqAvalEdita() && avalOk(mudados());
      allow delete: if eqAvalEdita();
    }

    // ---------- Módulo Efetivo: fichas de acompanhamento ----------
    // gestao/config: tipos de ocorrência e texto da ficha (todos do Efetivo). gestao/colaboradores: lista antiga,
    // de antes da divisão por área (só quem vê todas as áreas; é apagada na migração).
    match /gestao/{docId} {
      allow read: if ge() && (docId != 'colaboradores' || todasFichas());
      allow write: if admMod('gestao');
    }
    // Fichas dos colaboradores, um documento por área.
    function gcolabOk(ch) { return soCampos(ch, ['itens', 'atualizadoPor', 'atualizadoEm']) && fLista(request.resource.data, ch, 'itens', 3000); }
    // Gravam: quem administra as fichas e o RH · Administrativo (RH › Colaboradores, o cadastro único).
    match /gcolab/{area} {
      allow read: if todasFichas() || minhaFicha(area) || acAdm() || indAlgum();   // Indicadores: grupos da frequência pela ficha
      allow create: if (admMod('gestao') || admEdita()) && marcaOk() && gcolabOk(novos());
      allow update: if (admMod('gestao') || admEdita()) && marcaOk() && gcolabOk(mudados());
      allow delete: if admMod('gestao');
    }
    // Ocorrências: da área, ou registradas pela pessoa, ou que ela vai recolher (recolhe = nome em maiúsculas,
    // comparado com usuarios/{uid}.nomeUp, que o sistema grava no cadastro).
    function veOcorr(o) { return hasProfile() && veOcorrU(perfil(), o); }
    function mudaOcorr(o) {
      let u = perfil();
      return admGestaoU(u) || (geEditaU(u) && veOcorrU(u, o) && soAltera(['status', 'assinadoEm', 'assinaturaId', 'metodo', 'testemunha', 'recolhe', 'atualizadoEm', 'atualizadoPor']));
    }
    match /gocorr/{id} {
      allow read: if veOcorr(resource.data);
      allow create: if geEdita() && request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time
        && request.resource.data.area is string && (todasFichas() || minhaFicha(request.resource.data.area));
      allow update: if hasProfile() && marcaOk() && mudaOcorr(resource.data);
      allow delete: if admMod('gestao');
    }
    // Assinaturas: não mudam depois de gravadas (a administração só acerta a área quando a pessoa muda de área).
    match /gassin/{id} {
      allow read: if todasFichas() || (ge() && (minhaFicha(resource.data.area) || resource.data.por == request.auth.uid));
      allow create: if geEdita() && request.resource.data.por == request.auth.uid && request.resource.data.area is string;
      allow update: if admMod('gestao') && soAltera(['area']);
      allow delete: if admin();
    }

    // Escala de turno (regimes, turmas e feriados) usada por todos os módulos. Todos leem; administrador e gestor alteram.
    match /config/escalas {
      allow read: if ativo();
      allow write: if admin() || (ativo() && pEm('administracao') == 'modulo' && (pEm('gestao') == 'gestor' || pEm('operacao') == 'gestor'));
    }

    // Lista oficial das funções (cargos), Administração › Funções. Só o administrador lê e grava.
    match /config/funcoes {
      allow read: if admin();
      allow write: if admin() && request.resource.data.lista is list && request.resource.data.lista.size() <= 300;
    }

    // Abas que cada perfil vê (tela Perfis e permissões). Todos leem; só o administrador muda.
    // A exceção por pessoa fica no campo abas de usuarios/{uid}, que só o administrador altera.
    match /config/permissoes {
      allow read: if ativo();
      allow write: if admin();
    }

    // Avisos no celular: chave pública do Web Push (config/avisos) e os aparelhos/preferências de cada pessoa.
    match /config/avisos {
      allow read: if ativo();
      allow write: if admin();
    }
    // Resultado da última execução da rotina de avisos (gravado pela rotina; o administrador acompanha no Meu dia).
    match /avisos_enviados/{docId} {
      allow get: if admin();
    }
    match /avisos/{uid} {
      allow read, write: if ativo() && request.auth.uid == uid;
      allow read: if admin();
    }

    // Ponte com o Senior: a rotina do GitHub grava com a chave de serviço; só o administrador lê e marca como aplicado.
    match /integracao/{docId} {
      allow read: if admin();
      allow update: if admin() && soAltera(['aplicadoEm', 'aplicadoPor']);
    }

    // ---------- Acesso Administrativo ----------
    // Folha de frequência de cada competência (16 a 15): grupos, pessoas e os dias de quem não está nas Atividades.
    // Quem está nas Atividades tem a presença em situacao/b_situacao (a mesma do Efetivo diário).
    // id = 'conj|AAAA-MM' (conj = patio ou bateria); grupos[] = grupos e pessoas; d e jus = dias e justificativas por pessoa.
    function compOk(d, ch) {
      return fTxt(d, ch, 'conj', 10) && fTxt(d, ch, 'competencia', 7) && fDia(d, ch, 'ini') && fDia(d, ch, 'fim') && fLista(d, ch, 'grupos', 300)
        && fMapa(d, ch, 'd', 3000) && fMapa(d, ch, 'jus', 3000) && fTxt(d, ch, 'aba', 120) && d.keys().size() <= 30; }
    match /freqcomp/{id} {
      // Equipe e frota (Operação) lê a folha para a situação dos operadores; os Indicadores, a do conjunto do escopo.
      allow read: if acAdm() || eqmI() || (id.matches('patio[|].*') && indE('patio')) || (id.matches('bateria[|].*') && indE('bateria'));
      allow create: if admEdita() && request.resource.data.get('conj', '') in ['patio', 'bateria'] && request.resource.data.get('competencia', '') is string
        && id == request.resource.data.conj + '|' + request.resource.data.competencia && request.resource.data.competencia.matches('[0-9]{4}-[0-9]{2}')
        && compOk(request.resource.data, novos());
      allow update: if admEdita() && !mudados().hasAny(['conj', 'competencia']) && compOk(request.resource.data, mudados());
      allow delete: if admEdita();
    }
    // Férias: um documento por período. nome obrigatório; datas AAAA-MM-DD; dias de 0 a 365.
    function feriasOk(d, ch) {
      return fTxtNum(d, ch, 'mat', 30) && fTxt(d, ch, 'nome', 150) && fTxt(d, ch, 'setor', 80) && fTxt(d, ch, 'funcao', 120) && fTxt(d, ch, 'horario', 40)
        && fDia(d, ch, 'inicio') && fDia(d, ch, 'termino') && fDia(d, ch, 'retorno') && fDia(d, ch, 'limite') && fDia(d, ch, 'admissao')
        && fNum(d, ch, 'dias', 0, 365) && fTxt(d, ch, 'substituto', 300) && fTxt(d, ch, 'obs', 500) && fTxt(d, ch, 'aba', 120)
        && fTxt(d, ch, 'mesPlanejado', 7) && fSim(d, ch, 'apagado') && d.keys().size() <= 30; }
    match /ferias/{id} {
      allow read: if acAdm() || indAlgum();
      allow create: if admEdita() && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() > 0 && feriasOk(request.resource.data, novos());
      allow update: if admEdita() && feriasOk(request.resource.data, mudados());
      allow delete: if admEdita();
    }
    // Treinamentos, NRs e ASO (Segurança › Treinamentos e ASO; saiu do RH em 2026-11-10): um documento por treinamento
    // feito. Quem tem a Segurança lê; os técnicos de segurança (registra, trata, gestor) e o administrador gravam, um a um
    // ou pela importação da planilha. Os "não se aplica" de cada pessoa ficam num documento só (naTipos).
    function treinoLe() { return ativo() && (admin() || pEm('seguranca') != '' || pEm('indicadores') != ''); }
    function treinoEdita() { return ativo() && (admin() || pEm('seguranca') in ['registra', 'trata', 'gestor']); }
    function treinoOk(d, ch) {
      return fTxtNum(d, ch, 'mat', 30) && fTxt(d, ch, 'nome', 150) && fTxt(d, ch, 'tipo', 120)
        && fTxt(d, ch, 'setor', 80) && fTxt(d, ch, 'area', 80) && fTxt(d, ch, 'conj', 10) && fTxt(d, ch, 'supervisor', 150) && fTxt(d, ch, 'turno', 40)
        && fTxt(d, ch, 'funcao', 120) && fDia(d, ch, 'admissao') && fDia(d, ch, 'realizado') && fDia(d, ch, 'validade') && fTxt(d, ch, 'obs', 500)
        && fSim(d, ch, 'na') && fSim(d, ch, 'apagado') && fLista(d, ch, 'naTipos', 200) && d.keys().size() <= 30; }
    match /treinos/{id} {
      allow read: if treinoLe();
      allow create: if treinoEdita() && request.resource.data.tipo is string && request.resource.data.nome is string
        && request.resource.data.tipo.size() > 0 && request.resource.data.nome.size() > 0 && treinoOk(request.resource.data, novos());
      allow update: if treinoEdita() && request.resource.data.tipo is string && request.resource.data.nome is string && treinoOk(request.resource.data, mudados());
      allow delete: if treinoEdita();
    }
    // adm/feriasAtivas: resumo das férias de agora e dos próximos meses, lido pela Operação (marca FE sozinho).
    match /adm/{docId} {
      allow read: if ativo();
      allow write: if admEdita();
    }
    // Uso do plano grátis (gravado pela rotina do GitHub; o administrador acompanha).
    match /sistema/{docId} {
      allow read: if admin();
      allow write: if false;
    }

    // ---------- Módulo Segurança: registros de interação e de anomalia ----------
    // Só registra quem o administrador autorizou (Segurança · registra, trata ou gestor). Quem só registra lê só o que
    // registrou; trata, gestor, somente leitura e o administrador leem tudo. O supervisor da área (Operação · Supervisor
    // com uma das áreas dele dentro do conjunto da anomalia: conj = patio | bateria) lê e trata as anomalias e
    // lê as interações da área. O acompanhamento (status, trat, conclEm) é de quem trata e do supervisor da área; o autor
    // corrige o próprio registro por 24 h (a anomalia, só enquanto aberta). Apagar = administrador. As fotos (segfotos)
    // levam o autor e o conjunto do registro e seguem as mesmas regras de leitura.
    function segP() { return pEm('seguranca'); }
    function segRegistra() { return admin() || (ativo() && segP() in ['registra', 'trata', 'gestor']); }
    function segTudo() { return admin() || (ativo() && segP() in ['trata', 'gestor', 'leitor']); }
    function segTrata() { return admin() || (ativo() && segP() in ['trata', 'gestor']); }
    function areasDoConj(conj) { return conj == 'patio' ? ['RECEBIMENTO', 'FINAL DO PÁTIO', 'PREPARAÇÃO', 'TRATAMENTO DE COQUE'] : ['BATERIA 1', 'BATERIA 2', 'TRILHO', 'CDQ']; }
    function supSeg(conj) {
      return conj in ['patio', 'bateria'] && ativo()
        && pEm('operacao') == 'supervisor' && esc(conj)
        && (perfil().get('area', '') in areasDoConj(conj) || perfil().get('area2', '') in areasDoConj(conj)
            || perfil().get('areas', []).hasAny(areasDoConj(conj)));
    }
    // Indicadores: os registros do conjunto do escopo (só leitura).
    function segLe(r) { return segTudo() || (r.por == request.auth.uid && segRegistra()) || supSeg(r.conj) || (r.conj in ['patio', 'bateria'] && indE(r.conj)); }
    function txtOk(d, k, min, max) { return d.get(k, '') is string && d.get(k, '').size() >= min && d.get(k, '').size() <= max; }
    function dataOk(d) { return d.data is string && d.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.mes == d.data.split('-')[0] + '-' + d.data.split('-')[1]; }
    function regOk(d) {
      return dataOk(d) && txtOk(d, 'area', 1, 60) && d.get('conj', '') in ['patio', 'bateria', '']
        && d.conj is string && txtOk(d, 'local', 1, 120) && txtOk(d, 'mat', 1, 30) && d.get('fotos', []) is list && d.get('minis', []) is list
        && d.get('fotos', []).size() <= 6 && d.get('minis', []).size() <= 6 && d.por is string && txtOk(d, 'porNome', 0, 120);
    }
    function interOk(d) {
      return regOk(d) && d.keys().hasOnly(['data', 'mes', 'area', 'conj', 'local', 'tipoAtiv', 'risco', 'desvios', 'desvioOutro', 'desc', 'acao', 'resp', 'mat', 'fotos', 'minis', 'por', 'porNome', 'em', 'atualizadoEm'])
        && txtOk(d, 'tipoAtiv', 1, 40) && txtOk(d, 'risco', 0, 500) && d.get('desvios', []) is list && d.get('desvios', []).size() <= 40
        && txtOk(d, 'desvioOutro', 0, 200) && txtOk(d, 'desc', 0, 3000) && txtOk(d, 'acao', 0, 3000) && txtOk(d, 'resp', 1, 120);
    }
    function anomOk(d) {
      return regOk(d) && d.keys().hasOnly(['data', 'hora', 'mes', 'area', 'conj', 'local', 'regime', 'desc', 'conseq', 'acao', 'causas', 'sugest', 'comunic', 'mat', 'fotos', 'minis', 'por', 'porNome', 'em', 'status', 'trat', 'conclEm', 'atualizadoEm', 'atualizadoPor', 'insp'])
        && txtOk(d, 'insp', 0, 40) && d.hora is string && d.hora.matches('[0-9]{2}:[0-9]{2}') && txtOk(d, 'regime', 1, 40)
        && txtOk(d, 'desc', 1, 3000) && txtOk(d, 'conseq', 1, 3000) && txtOk(d, 'acao', 1, 3000) && txtOk(d, 'causas', 1, 3000)
        && txtOk(d, 'sugest', 1, 3000) && txtOk(d, 'comunic', 1, 120) && d.status in ['aberta', 'tratamento', 'concluida'];
    }
    // Acompanhamento: situação, responsável, prazo, comentário, foto do depois (obrigatória para concluir) e histórico.
    function tratOk(d) {
      let t = d.get('trat', {});
      return d.status in ['aberta', 'tratamento', 'concluida'] && t is map
        && t.keys().hasOnly(['resp', 'respUid', 'prazo', 'coment', 'fotoDepois', 'miniDepois', 'hist'])
        && t.get('resp', '') is string && t.get('resp', '').size() <= 120 && t.get('coment', '') is string && t.get('coment', '').size() <= 3000
        && t.get('prazo', '') is string && t.get('hist', []) is list && t.get('hist', []).size() <= 150
        && t.get('miniDepois', '') is string && t.get('miniDepois', '').size() < 80000
        && (d.status != 'concluida' || (t.get('fotoDepois', '') is string && t.get('fotoDepois', '') != ''))
        && d.get('conclEm', '') is string;
    }
    // Campos que o autor corrige (o resto não muda).
    function corrige(col) {
      return col == 'seginter'
        ? soAltera(['data', 'mes', 'area', 'conj', 'local', 'tipoAtiv', 'risco', 'desvios', 'desvioOutro', 'desc', 'acao', 'resp', 'mat', 'atualizadoEm'])
        : soAltera(['data', 'hora', 'mes', 'area', 'conj', 'local', 'regime', 'desc', 'conseq', 'acao', 'causas', 'sugest', 'comunic', 'mat', 'atualizadoEm']);
    }
    function autorNoPrazo() { return segRegistra() && resource.data.por == request.auth.uid && request.time < resource.data.em + duration.value(24, 'h'); }
    match /seginter/{id} {
      allow read: if segLe(resource.data);
      allow create: if segRegistra() && interOk(request.resource.data) && request.resource.data.por == request.auth.uid && request.resource.data.em == request.time;
      allow update: if autorNoPrazo() && corrige('seginter') && interOk(request.resource.data);
      allow delete: if admin();
    }
    match /seganom/{id} {
      allow read: if segLe(resource.data);
      allow create: if segRegistra() && anomOk(request.resource.data) && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time && request.resource.data.status == 'aberta' && !('trat' in request.resource.data);
      allow update: if ((segTrata() || supSeg(resource.data.conj)) && soAltera(['status', 'trat', 'conclEm', 'atualizadoEm', 'atualizadoPor']) && tratOk(request.resource.data))
        || (autorNoPrazo() && resource.data.status == 'aberta' && corrige('seganom') && anomOk(request.resource.data));
      allow delete: if admin();
    }
    // Inspeções (Segurança › Inspeções, contas/inspecoes.js): 5S, segurança ou limpeza e qualidade da área, com os itens
    // (OK / Não OK / N/A) e a nota. Registra e lê como os outros registros da Segurança; o autor corrige por 24 h (no mesmo
    // lote, os itens Não OK novos viram anomalias com o id da inspeção); apagar = administrador.
    function segInspOk(d) {
      return dataOk(d) && txtOk(d, 'area', 1, 60) && d.get('conj', '') in ['patio', 'bateria', ''] && d.conj is string && txtOk(d, 'local', 1, 120)
        && d.keys().hasOnly(['tipo', 'data', 'mes', 'area', 'conj', 'local', 'itens', 'nota', 'obs', 'por', 'porNome', 'em', 'atualizadoEm'])
        && d.tipo in ['s5', 'seg', 'area'] && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 20
        && (d.get('nota', null) == null || (d.nota is number && d.nota >= 0 && d.nota <= 100))
        && txtOk(d, 'obs', 0, 2000) && d.por is string && txtOk(d, 'porNome', 0, 120);
    }
    match /seginsp/{id} {
      allow read: if segLe(resource.data);
      allow create: if segRegistra() && segInspOk(request.resource.data) && request.resource.data.por == request.auth.uid && request.resource.data.em == request.time;
      allow update: if autorNoPrazo() && soAltera(['tipo', 'data', 'mes', 'area', 'conj', 'local', 'itens', 'nota', 'obs', 'atualizadoEm']) && segInspOk(request.resource.data);
      allow delete: if admin();
    }

    // Cartão Amarelo (Direito ao Trabalho Seguro): registra quem registra na Segurança (nasce pendente, sem validação);
    // lê como os outros registros; valida quem trata as anomalias (trata, gestor, administrador = Seg. do Trabalho)
    // e o supervisor da área (Líder imediato), só nos campos da validação. O autor corrige por 24 h enquanto pendente.
    function cartaoOk(d) {
      return dataOk(d) && txtOk(d, 'area', 1, 60) && d.get('conj', '') in ['patio', 'bateria', ''] && d.conj is string
        && d.keys().hasOnly(['data', 'mes', 'area', 'conj', 'faltou', 'motivo', 'comoSeguro', 'comunic', 'mat', 'fotos', 'minis', 'por', 'porNome', 'em', 'status', 'valid', 'atualizadoEm', 'atualizadoPor'])
        && d.get('faltou', []) is list && d.get('faltou', []).size() <= 3
        && txtOk(d, 'motivo', 1, 3000) && txtOk(d, 'comoSeguro', 1, 3000) && txtOk(d, 'comunic', 1, 120) && txtOk(d, 'mat', 1, 30)
        && d.get('fotos', []) is list && d.get('minis', []) is list && d.get('fotos', []).size() <= 6 && d.get('minis', []).size() <= 6
        && d.por is string && txtOk(d, 'porNome', 0, 120) && d.status in ['pendente', 'validado'];
    }
    function validOk(d) {
      let v = d.get('valid', {});
      return d.status in ['pendente', 'validado'] && v is map && v.keys().hasOnly(['tipo', 'nome', 'mat', 'uid', 'em'])
        && (d.status == 'pendente' || (v.get('tipo', '') in ['lider', 'seg'] && txtOk(v, 'nome', 1, 120) && txtOk(v, 'mat', 1, 30)))
        && v.get('uid', '') is string && v.get('em', '') is string;
    }
    match /segcartao/{id} {
      allow read: if segLe(resource.data);
      allow create: if segRegistra() && cartaoOk(request.resource.data) && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time && request.resource.data.status == 'pendente' && !('valid' in request.resource.data);
      allow update: if ((segTrata() || supSeg(resource.data.conj)) && soAltera(['status', 'valid', 'atualizadoEm', 'atualizadoPor']) && validOk(request.resource.data))
        || (autorNoPrazo() && resource.data.status == 'pendente'
            && soAltera(['data', 'mes', 'area', 'conj', 'faltou', 'motivo', 'comoSeguro', 'comunic', 'mat', 'atualizadoEm']) && cartaoOk(request.resource.data));
      allow delete: if admin();
    }
    // DDS antigos (diálogo diário de segurança): a função saiu do site em 2026-11. Os registros ficam guardados no banco:
    // lê quem lê a Segurança, ninguém grava mais e só o administrador apaga.
    match /segdds/{id} {
      allow read: if segLe(resource.data);
      allow create, update: if false;
      allow delete: if admin();
    }
    // Fotos: uma por documento (até ~700 KB). 'antes' = do registro, gravada pelo autor junto com ele; 'depois' = do
    // tratamento, gravada por quem trata. autor e conj vêm do registro (conferidos com getAfter).
    function fotoRegOk(d) {
      let r = getAfter(/databases/$(database)/documents/$(d.col)/$(d.reg)).data;
      return r.por == d.autor && r.get('conj', '') == d.conj;
    }
    match /segfotos/{id} {
      allow read: if segTudo() || (resource.data.autor == request.auth.uid && segRegistra()) || supSeg(resource.data.conj);
      allow create: if request.resource.data.por == request.auth.uid && request.resource.data.col in ['seginter', 'seganom', 'segcartao']
        && request.resource.data.reg is string && request.resource.data.dados is string && request.resource.data.dados.size() < 700000
        && request.resource.data.mini is string && request.resource.data.mini.size() < 80000 && request.resource.data.conj is string
        && ((request.resource.data.tipo == 'antes' && segRegistra() && request.resource.data.autor == request.auth.uid)
            || (request.resource.data.tipo == 'depois' && request.resource.data.col == 'seganom' && (segTrata() || supSeg(request.resource.data.conj))))
        && fotoRegOk(request.resource.data);
      allow update: if false;
      allow delete: if admin();
    }
    // Listas dos formulários (áreas, tipos de atividade, regimes e desvios): todos os ativos leem; o administrador e a
    // Administração 'Dos módulos' de quem é Gestor da Segurança alteram.
    match /config/seguranca {
      allow read: if ativo();
      allow write: if admin() || (ativo() && pEm('administracao') == 'modulo' && segP() == 'gestor');
    }

    // Painel Coqueria (repositório Gest-o-Eduardo): o site foi desligado em 2026-11 e os dados foram trazidos para o Dikma.
    // O que ficou em painel/{uid}/... continua guardado (e na cópia de segurança), só para leitura da própria pessoa.
    match /painel/{uid}/{document=**} {
      allow read: if ativo() && request.auth.uid == uid;
    }

    // Histórico de alterações (contas/acessos.js › modsHistorico): o administrador lê tudo, também os registros antigos,
    // sem módulo; o gestor de cada módulo lê só os do módulo dele (no RH, o Administrativo). A Administração fica só com
    // o administrador. Quem grava: o próprio usuário, com o nome do cadastro e a hora do servidor; ninguém altera.
    function veHist(m) {
      return admin() || (ativo() && ((m == 'operacao' && pEm('operacao') == 'gestor') || (m == 'gestao' && pEm('gestao') == 'gestor')
        || (m == 'seguranca' && pEm('seguranca') == 'gestor') || (m == 'rh' && pEm('rh') == 'administrativo')));
    }
    // LGPD: quem abriu a ficha de quem (ui/acessos-ficha.js). Id = uid|mat|ficha|dia: uma linha por dia. Cada um grava só
    // o próprio acesso, com a hora do servidor; ninguém altera; só o administrador lê e apaga (descarte por prazo).
    match /acessosFicha/{id} {
      allow read, delete: if admin();
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'nome', 'mat', 'pessoa', 'ficha', 'dia'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.nome == perfil().get('nome', '')
        && request.resource.data.ficha in ['rh', 'gestao']
        && request.resource.data.mat is string && request.resource.data.mat.size() > 0 && request.resource.data.mat.size() <= 30
        && request.resource.data.pessoa is string && request.resource.data.pessoa.size() <= 120
        && request.resource.data.dia is string && request.resource.data.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && id == request.auth.uid + '|' + request.resource.data.mat + '|' + request.resource.data.ficha + '|' + request.resource.data.dia;
    }
    // Dados pessoais (CPF, endereço, telefone, rota de ônibus): dpessoais/{matrícula Dikma}, fora da ficha (gcolab), que é
    // lida por líderes, leitores e Indicadores. Lê: administrador e RH · Administrativo (o administrador pode desligar em
    // Perfis); RH · Somente leitura só com o item ligado em Perfis (config/permissoes 'rh|leitor'.i_dpessoais = true).
    // Grava: administrador e RH · Administrativo. Apaga: só o administrador (descarte LGPD, 2 anos após a demissão).
    function dpItem(p) {
      let pr = /databases/$(database)/documents/config/permissoes;
      let v = exists(pr) ? get(pr).data.get('rh|' + p, {}).get('i_dpessoais', null) : null;
      return p == 'administrativo' ? v != false : v == true;
    }
    function veDP() { return admin() || (ativo() && pEm('rh') in ['administrativo', 'leitor'] && dpItem(pEm('rh'))); }
    function dpOk(mat, ch) {
      let d = request.resource.data;
      return soCampos(ch, ['mat', 'cpf', 'end', 'tel', 'rotaOn', 'atualizadoPor', 'atualizadoEm'])
        && d.get('mat', '') == mat
        && (d.get('cpf', null) == null || (d.cpf is string && d.cpf.matches('[0-9]{11}')))
        && fTxt(d, ch, 'end', 300) && fTxt(d, ch, 'tel', 40) && fTxt(d, ch, 'rotaOn', 40);
    }
    match /dpessoais/{mat} {
      allow read: if veDP();
      allow create: if admEdita() && marcaOk() && dpOk(mat, novos());
      allow update: if admEdita() && marcaOk() && dpOk(mat, mudados());
      allow delete: if admin();
    }
    match /historico/{id} {
      allow read: if veHist(resource.data.get('mod', ''));
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'nome', 't', 'mod'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.nome == perfil().get('nome', '')
        && request.resource.data.mod in ['operacao', 'gestao', 'seguranca', 'rh', 'administracao']
        && request.resource.data.t is string && request.resource.data.t.size() <= 1000;
      allow update: if false;
      allow delete: if admin();   // Limpeza de dados (histórico antigo)
    }
    // Erros que aconteceram no aparelho de quem usa (nucleo/erros.js). Cada um grava só os próprios, com campos curtos;
    // só o administrador lê e apaga (Administração › Erros nos aparelhos).
    match /erros/{id} {
      allow read, delete: if admin();
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['quando', 'uid', 'msg', 'onde', 'tela', 'versao', 'aparelho', 'vezes'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.quando == request.time
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.get('onde', '') is string && request.resource.data.get('onde', '').size() <= 200
        && request.resource.data.get('tela', '') is string && request.resource.data.get('tela', '').size() <= 40
        && request.resource.data.get('versao', '') is string && request.resource.data.get('versao', '').size() <= 40
        && request.resource.data.get('aparelho', '') is string && request.resource.data.get('aparelho', '').size() <= 200
        && request.resource.data.get('vezes', 1) is int && request.resource.data.get('vezes', 1) <= 1000;
      allow update: if false;
    }
  }
}
